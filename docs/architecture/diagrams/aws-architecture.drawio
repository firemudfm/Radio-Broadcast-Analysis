        <mxCell id="p2-h1" value="&lt;b&gt;PROCESS&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11;fontStyle=0;fontColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="108" y="120" width="250" height="32" as="geometry" />
        </mxCell>
        <mxCell id="p2-h2" value="&lt;b&gt;WHAT HAPPENS&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11;fontStyle=0;fontColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="372" y="120" width="1320" height="32" as="geometry" />
        </mxCell>
        <mxCell id="p2-h3" value="&lt;b&gt;DURABLE EFFECT&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11;fontStyle=0;fontColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="1706" y="120" width="530" height="32" as="geometry" />
        </mxCell>
        <mxCell id="p2-phA" value="&lt;b&gt;A&lt;/b&gt; &amp;nbsp; Intent &amp;mdash; the control plane records what to watch" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EEF3FB;strokeColor=#2E5AAC;fontColor=#2E5AAC;fontSize=12;fontStyle=0;align=left;verticalAlign=top;spacingLeft=12;spacingRight=12;spacingTop=4;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="162" width="2210" height="30" as="geometry" />
        </mxCell>
        <mxCell id="p2-r1" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5DBE3;fontColor=#232F3E;fontSize=11;fontStyle=0;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="200" width="2210" height="86" as="geometry" />
        </mxCell>
        <mxCell id="p2-b1" value="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#232F3E;strokeColor=#ffffff;strokeWidth=2;fontColor=#ffffff;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="54" y="210" width="28" height="28" as="geometry" />
        </mxCell>
        <mxCell id="p2-a1" value="&lt;b&gt;browser &amp;rarr; api&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11;fontStyle=0;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="108" y="208" width="250" height="40" as="geometry" />
        </mxCell>
        <mxCell id="p2-t1" value="&lt;code&gt;POST /api/v1/brand-signal/campaigns&lt;/code&gt;. Station ids are validated against the station map; &lt;code&gt;backfill_days&lt;/code&gt; becomes &lt;code&gt;monitor_from&lt;/code&gt;. The API records &lt;b&gt;intent only&lt;/b&gt; &amp;mdash; it never opens a stream." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10;fontStyle=0;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="372" y="206" width="1320" height="74" as="geometry" />
        </mxCell>
        <mxCell id="p2-e1" value="&amp;mdash;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=9;fontStyle=0;fontColor=#4C7A0B;" vertex="1" parent="1">
          <mxGeometry x="1706" y="206" width="530" height="74" as="geometry" />
        </mxCell>
        <mxCell id="p2-r2" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5DBE3;fontColor=#232F3E;fontSize=11;fontStyle=0;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="294" width="2210" height="86" as="geometry" />
        </mxCell>
        <mxCell id="p2-b2" value="2" style="ellipse;whiteSpace=wrap;html=1;fillColor=#232F3E;strokeColor=#ffffff;strokeWidth=2;fontColor=#ffffff;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="54" y="304" width="28" height="28" as="geometry" />
        </mxCell>
        <mxCell id="p2-a2" value="&lt;b&gt;api &amp;rarr; SQLite + S3&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11;fontStyle=0;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="108" y="302" width="250" height="40" as="geometry" />
        </mxCell>
        <mxCell id="p2-t2" value="&lt;b&gt;ONE TXN:&lt;/b&gt; 1 &amp;times; &lt;code&gt;campaigns&lt;/code&gt; (status=active) + N &amp;times; &lt;code&gt;campaign_stations&lt;/code&gt; + N &amp;times; &lt;code&gt;campaign_keywords&lt;/code&gt;, then a revision bump. The merged entity document is put to S3 and an immediate sync runs." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10;fontStyle=0;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="372" y="300" width="1320" height="74" as="geometry" />
        </mxCell>
        <mxCell id="p2-e2" value="campaigns, campaign_stations,&lt;br&gt;campaign_keywords&lt;br&gt;s3://&amp;hellip;/config/keywords/keywords.json" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=9;fontStyle=0;fontColor=#4C7A0B;" vertex="1" parent="1">
          <mxGeometry x="1706" y="300" width="530" height="74" as="geometry" />
        </mxCell>
        <mxCell id="p2-phB" value="&lt;b&gt;B&lt;/b&gt; &amp;nbsp; Planning &amp;mdash; campaigns become stations, de-duplicated" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F3EEFB;strokeColor=#6B3FBF;fontColor=#6B3FBF;fontSize=12;fontStyle=0;align=left;verticalAlign=top;spacingLeft=12;spacingRight=12;spacingTop=4;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="394" width="2210" height="30" as="geometry" />
        </mxCell>
        <mxCell id="p2-r3" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5DBE3;fontColor=#232F3E;fontSize=11;fontStyle=0;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="432" width="2210" height="86" as="geometry" />
        </mxCell>
        <mxCell id="p2-b3" value="3" style="ellipse;whiteSpace=wrap;html=1;fillColor=#232F3E;strokeColor=#ffffff;strokeWidth=2;fontColor=#ffffff;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="54" y="442" width="28" height="28" as="geometry" />
        </mxCell>
        <mxCell id="p2-a3" value="&lt;b&gt;planner (every 5 s)&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11;fontStyle=0;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="108" y="440" width="250" height="40" as="geometry" />
        </mxCell>
        <mxCell id="p2-t3" value="Active campaigns are grouped by &lt;b&gt;DISTINCT&lt;/b&gt; station. One &lt;code&gt;station_subscriptions&lt;/code&gt; row per station carries &lt;code&gt;reference_count&lt;/code&gt; (how many campaigns want it) and &lt;code&gt;shard_index = BLAKE2b(station_id) % shards&lt;/code&gt; &amp;mdash; never Python's &lt;code&gt;hash()&lt;/code&gt;, which is per-process randomised and would split-brain two listeners." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10;fontStyle=0;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="372" y="438" width="1320" height="74" as="geometry" />
        </mxCell>
        <mxCell id="p2-e3" value="station_subscriptions" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=9;fontStyle=0;fontColor=#4C7A0B;" vertex="1" parent="1">
          <mxGeometry x="1706" y="438" width="530" height="74" as="geometry" />
        </mxCell>
        <mxCell id="p2-r4" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5DBE3;fontColor=#232F3E;fontSize=11;fontStyle=0;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="526" width="2210" height="86" as="geometry" />
        </mxCell>
        <mxCell id="p2-b4" value="4" style="ellipse;whiteSpace=wrap;html=1;fillColor=#232F3E;strokeColor=#ffffff;strokeWidth=2;fontColor=#ffffff;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="54" y="536" width="28" height="28" as="geometry" />
        </mxCell>
        <mxCell id="p2-a4" value="&lt;b&gt;planner &amp;rarr; Radio Browser&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11;fontStyle=0;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="108" y="534" width="250" height="40" as="geometry" />
        </mxCell>
        <mxCell id="p2-t4" value="A campaign stores a station id; the listener needs a URL. Resolution is durable-first (&lt;code&gt;managed_stations.stream_url_resolved&lt;/code&gt;), then &lt;code&gt;/json/url/&amp;lt;uuid&amp;gt;&lt;/code&gt;. Budgeted per cycle and backed off on failure &amp;mdash; that endpoint counts a click." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10;fontStyle=0;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="372" y="532" width="1320" height="74" as="geometry" />
        </mxCell>
        <mxCell id="p2-e4" value="station_subscriptions.stream_url" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=9;fontStyle=0;fontColor=#4C7A0B;" vertex="1" parent="1">
          <mxGeometry x="1706" y="532" width="530" height="74" as="geometry" />
        </mxCell>
        <mxCell id="p2-r5" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5DBE3;fontColor=#232F3E;fontSize=11;fontStyle=0;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="620" width="2210" height="86" as="geometry" />
        </mxCell>
        <mxCell id="p2-b5" value="5" style="ellipse;whiteSpace=wrap;html=1;fillColor=#232F3E;strokeColor=#ffffff;strokeWidth=2;fontColor=#ffffff;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="54" y="630" width="28" height="28" as="geometry" />
        </mxCell>
        <mxCell id="p2-a5" value="&lt;b&gt;planner&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11;fontStyle=0;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="108" y="628" width="250" height="40" as="geometry" />
        </mxCell>
        <mxCell id="p2-t5" value="Builds the &lt;b&gt;combined&lt;/b&gt; keyword index for the station from every campaign that references it and publishes a new version only when the content fingerprint changed. Then admits up to &lt;code&gt;RADIO_MAX_ACTIVE_UNIQUE_STATIONS&lt;/code&gt;; the overflow is parked as &lt;code&gt;pending_capacity&lt;/code&gt; with a stated reason &amp;mdash; a queue, never a silent drop." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10;fontStyle=0;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="372" y="626" width="1320" height="74" as="geometry" />
        </mxCell>
        <mxCell id="p2-e5" value="station_keyword_index_versions,&lt;br&gt;station_keyword_bindings" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=9;fontStyle=0;fontColor=#4C7A0B;" vertex="1" parent="1">
          <mxGeometry x="1706" y="626" width="530" height="74" as="geometry" />
        </mxCell>
        <mxCell id="p2-phC" value="&lt;b&gt;C&lt;/b&gt; &amp;nbsp; Capture &amp;mdash; the only place audio exists" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFF4EC;strokeColor=#C4590C;fontColor=#C4590C;fontSize=12;fontStyle=0;align=left;verticalAlign=top;spacingLeft=12;spacingRight=12;spacingTop=4;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="720" width="2210" height="30" as="geometry" />
        </mxCell>
        <mxCell id="p2-r6" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5DBE3;fontColor=#232F3E;fontSize=11;fontStyle=0;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="758" width="2210" height="86" as="geometry" />
        </mxCell>
        <mxCell id="p2-b6" value="6" style="ellipse;whiteSpace=wrap;html=1;fillColor=#232F3E;strokeColor=#ffffff;strokeWidth=2;fontColor=#ffffff;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="54" y="768" width="28" height="28" as="geometry" />
        </mxCell>
        <mxCell id="p2-a6" value="&lt;b&gt;listener &amp;rarr; ffmpeg&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11;fontStyle=0;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="108" y="766" width="250" height="40" as="geometry" />
        </mxCell>
        <mxCell id="p2-t6" value="The URL is &lt;b&gt;re-validated on every connect&lt;/b&gt; (DNS can be re-pointed between configuration and use). ffmpeg runs with &lt;code&gt;-reconnect 0&lt;/code&gt; so every reconnect re-runs that check, and a &lt;code&gt;-protocol_whitelist&lt;/code&gt; that excludes &lt;code&gt;file&lt;/code&gt; and &lt;code&gt;concat&lt;/code&gt;. Output: 16 kHz mono s16le." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10;fontStyle=0;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="372" y="764" width="1320" height="74" as="geometry" />
        </mxCell>
        <mxCell id="p2-e6" value="station_sessions" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=9;fontStyle=0;fontColor=#4C7A0B;" vertex="1" parent="1">
          <mxGeometry x="1706" y="764" width="530" height="74" as="geometry" />
        </mxCell>
        <mxCell id="p2-r7" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5DBE3;fontColor=#232F3E;fontSize=11;fontStyle=0;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="852" width="2210" height="86" as="geometry" />
        </mxCell>
        <mxCell id="p2-b7" value="7" style="ellipse;whiteSpace=wrap;html=1;fillColor=#232F3E;strokeColor=#ffffff;strokeWidth=2;fontColor=#ffffff;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="54" y="862" width="28" height="28" as="geometry" />
        </mxCell>
        <mxCell id="p2-a7" value="&lt;b&gt;listener: ring buffer + classifier&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11;fontStyle=0;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="108" y="860" width="250" height="40" as="geometry" />
        </mxCell>
        <mxCell id="p2-t7" value="PCM lands in a fixed 1,920,000-byte ring buffer (60 s @ 16 kHz &amp;times; 2 B). Timestamps come from the &lt;b&gt;sample count&lt;/b&gt;, not &lt;code&gt;datetime.now()&lt;/code&gt;. A VAD + energy classifier scores 3 s windows: silence, clear music and long-form singing are &lt;b&gt;discarded in RAM&lt;/b&gt;; speech, speech-over-music, jingles and &lt;b&gt;uncertain&lt;/b&gt; are kept." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10;fontStyle=0;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="372" y="858" width="1320" height="74" as="geometry" />
        </mxCell>
        <mxCell id="p2-e7" value="nothing &amp;mdash; discarded audio never&lt;br&gt;touches the disk" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=9;fontStyle=0;fontColor=#4C7A0B;" vertex="1" parent="1">
          <mxGeometry x="1706" y="858" width="530" height="74" as="geometry" />
        </mxCell>
        <mxCell id="p2-r8" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5DBE3;fontColor=#232F3E;fontSize=11;fontStyle=0;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="946" width="2210" height="86" as="geometry" />
        </mxCell>
        <mxCell id="p2-b8" value="8" style="ellipse;whiteSpace=wrap;html=1;fillColor=#232F3E;strokeColor=#ffffff;strokeWidth=2;fontColor=#ffffff;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="54" y="956" width="28" height="28" as="geometry" />
        </mxCell>
        <mxCell id="p2-a8" value="&lt;b&gt;listener: encode + spool&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11;fontStyle=0;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="108" y="954" width="250" height="40" as="geometry" />
        </mxCell>
        <mxCell id="p2-t8" value="Segments of 20 s with 1 s overlap are encoded to Ogg/Opus 24 kbit/s &lt;code&gt;voip&lt;/code&gt; (lossless WAV fallback), then written tmp &amp;rarr; &lt;code&gt;fsync&lt;/code&gt; &amp;rarr; &lt;code&gt;os.replace&lt;/code&gt; &amp;rarr; directory fsync, with SHA-256 computed at write time." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10;fontStyle=0;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="372" y="952" width="1320" height="74" as="geometry" />
        </mxCell>
        <mxCell id="p2-e8" value="/var/lib/radio/spool/&amp;lt;station&amp;gt;/&lt;br&gt;&amp;lt;segment&amp;gt;.opus" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=9;fontStyle=0;fontColor=#4C7A0B;" vertex="1" parent="1">
          <mxGeometry x="1706" y="952" width="530" height="74" as="geometry" />
        </mxCell>
        <mxCell id="p2-r9" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5DBE3;fontColor=#232F3E;fontSize=11;fontStyle=0;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="1040" width="2210" height="86" as="geometry" />
        </mxCell>
        <mxCell id="p2-b9" value="9" style="ellipse;whiteSpace=wrap;html=1;fillColor=#232F3E;strokeColor=#ffffff;strokeWidth=2;fontColor=#ffffff;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="54" y="1050" width="28" height="28" as="geometry" />
        </mxCell>
        <mxCell id="p2-a9" value="&lt;b&gt;listener &amp;rarr; SQLite&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11;fontStyle=0;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="108" y="1048" width="250" height="40" as="geometry" />
        </mxCell>
        <mxCell id="p2-t9" value="&lt;b&gt;ONE TXN:&lt;/b&gt; &lt;code&gt;audio_segments&lt;/code&gt; (disposition=pending, sha256, size) + &lt;code&gt;transcription_jobs&lt;/code&gt; (pending) + &lt;code&gt;outbox_events&lt;/code&gt; (queue=transcription). Bytes land &lt;i&gt;before&lt;/i&gt; anything references them; if the transaction fails the file just written is deleted. Disk watermarks (70/85/90 %) are checked &lt;b&gt;before&lt;/b&gt; admitting." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10;fontStyle=0;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="372" y="1046" width="1320" height="74" as="geometry" />
        </mxCell>
        <mxCell id="p2-e9" value="audio_segments, transcription_jobs,&lt;br&gt;outbox_events" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=9;fontStyle=0;fontColor=#4C7A0B;" vertex="1" parent="1">
          <mxGeometry x="1706" y="1046" width="530" height="74" as="geometry" />
        </mxCell>
        <mxCell id="p2-phD" value="&lt;b&gt;D&lt;/b&gt; &amp;nbsp; Queue 1 &amp;rarr; transcribe &amp;rarr; match" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFF0F7;strokeColor=#B3106A;fontColor=#B3106A;fontSize=12;fontStyle=0;align=left;verticalAlign=top;spacingLeft=12;spacingRight=12;spacingTop=4;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="1140" width="2210" height="30" as="geometry" />
        </mxCell>
        <mxCell id="p2-r10" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5DBE3;fontColor=#232F3E;fontSize=11;fontStyle=0;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="1178" width="2210" height="86" as="geometry" />
        </mxCell>
        <mxCell id="p2-b10" value="10" style="ellipse;whiteSpace=wrap;html=1;fillColor=#232F3E;strokeColor=#ffffff;strokeWidth=2;fontColor=#ffffff;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="54" y="1188" width="28" height="28" as="geometry" />
        </mxCell>
        <mxCell id="p2-a10" value="&lt;b&gt;planner &amp;rarr; SQS FIFO 1&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11;fontStyle=0;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="108" y="1186" width="250" height="40" as="geometry" />
        </mxCell>
        <mxCell id="p2-t10" value="The dispatcher claims a batch of 25 with a 120 s lease, sends &lt;b&gt;outside&lt;/b&gt; any transaction, then records the outcome in a second short transaction. &lt;code&gt;MessageGroupId=station_id&lt;/code&gt;, &lt;code&gt;MessageDeduplicationId=segment_id&lt;/code&gt;." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10;fontStyle=0;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="372" y="1184" width="1320" height="74" as="geometry" />
        </mxCell>
        <mxCell id="p2-e10" value="outbox_events.status = sent" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=9;fontStyle=0;fontColor=#4C7A0B;" vertex="1" parent="1">
          <mxGeometry x="1706" y="1184" width="530" height="74" as="geometry" />
        </mxCell>
        <mxCell id="p2-r11" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5DBE3;fontColor=#232F3E;fontSize=11;fontStyle=0;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="1272" width="2210" height="86" as="geometry" />
        </mxCell>
        <mxCell id="p2-b11" value="11" style="ellipse;whiteSpace=wrap;html=1;fillColor=#232F3E;strokeColor=#ffffff;strokeWidth=2;fontColor=#ffffff;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="54" y="1282" width="28" height="28" as="geometry" />
        </mxCell>
        <mxCell id="p2-a11" value="&lt;b&gt;transcription-worker &amp;larr; SQS&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11;fontStyle=0;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="108" y="1280" width="250" height="40" as="geometry" />
        </mxCell>
        <mxCell id="p2-t11" value="Receives up to 5 with a 20 s long poll; visibility 300 s extended every 60 s (cap 1800 s). A known duplicate is deleted without work. A job older than 6 h is marked &lt;code&gt;abandoned&lt;/code&gt; and its audio released &amp;mdash; decoding a day-old backlog starves the fresh audio behind it." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10;fontStyle=0;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="372" y="1278" width="1320" height="74" as="geometry" />
        </mxCell>
        <mxCell id="p2-e11" value="inbox_messages (pre-check)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=9;fontStyle=0;fontColor=#4C7A0B;" vertex="1" parent="1">
          <mxGeometry x="1706" y="1278" width="530" height="74" as="geometry" />
        </mxCell>
        <mxCell id="p2-r12" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5DBE3;fontColor=#232F3E;fontSize=11;fontStyle=0;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="1366" width="2210" height="86" as="geometry" />
        </mxCell>
        <mxCell id="p2-b12" value="12" style="ellipse;whiteSpace=wrap;html=1;fillColor=#232F3E;strokeColor=#ffffff;strokeWidth=2;fontColor=#ffffff;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="54" y="1376" width="28" height="28" as="geometry" />
        </mxCell>
        <mxCell id="p2-a12" value="&lt;b&gt;transcription-worker &amp;larr; spool&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11;fontStyle=0;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="108" y="1374" width="250" height="40" as="geometry" />
        </mxCell>
        <mxCell id="p2-t12" value="The path is re-resolved inside the spool root with &lt;code&gt;O_NOFOLLOW&lt;/code&gt; and an &lt;code&gt;st_dev&lt;/code&gt;/&lt;code&gt;st_ino&lt;/code&gt; TOCTOU check, the size is compared, and the &lt;b&gt;SHA-256 recorded at write time is verified before any decoder sees the bytes&lt;/b&gt;." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10;fontStyle=0;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="372" y="1372" width="1320" height="74" as="geometry" />
        </mxCell>
        <mxCell id="p2-e12" value="&amp;mdash;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=9;fontStyle=0;fontColor=#4C7A0B;" vertex="1" parent="1">
          <mxGeometry x="1706" y="1372" width="530" height="74" as="geometry" />
        </mxCell>
        <mxCell id="p2-r13" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5DBE3;fontColor=#232F3E;fontSize=11;fontStyle=0;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="1460" width="2210" height="86" as="geometry" />
        </mxCell>
        <mxCell id="p2-b13" value="13" style="ellipse;whiteSpace=wrap;html=1;fillColor=#232F3E;strokeColor=#ffffff;strokeWidth=2;fontColor=#ffffff;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="54" y="1470" width="28" height="28" as="geometry" />
        </mxCell>
        <mxCell id="p2-a13" value="&lt;b&gt;transcription-worker: ASR pass A&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11;fontStyle=0;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="108" y="1468" width="250" height="40" as="geometry" />
        </mxCell>
        <mxCell id="p2-t13" value="faster-whisper &lt;code&gt;small&lt;/code&gt;, CTranslate2 int8, &lt;code&gt;beam_size=1&lt;/code&gt;, no word timestamps, language pinned only when exactly one usable hint exists. No-speech and repetition-loop guards drop bad segments. &lt;b&gt;ONE TXN:&lt;/b&gt; transcript + inbox row." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10;fontStyle=0;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="372" y="1466" width="1320" height="74" as="geometry" />
        </mxCell>
        <mxCell id="p2-e13" value="transcripts (asr_pass='a'),&lt;br&gt;inbox_messages" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=9;fontStyle=0;fontColor=#4C7A0B;" vertex="1" parent="1">
          <mxGeometry x="1706" y="1466" width="530" height="74" as="geometry" />
        </mxCell>
        <mxCell id="p2-r14" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5DBE3;fontColor=#232F3E;fontSize=11;fontStyle=0;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="1554" width="2210" height="86" as="geometry" />
        </mxCell>
        <mxCell id="p2-b14" value="14" style="ellipse;whiteSpace=wrap;html=1;fillColor=#232F3E;strokeColor=#ffffff;strokeWidth=2;fontColor=#ffffff;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="54" y="1564" width="28" height="28" as="geometry" />
        </mxCell>
        <mxCell id="p2-a14" value="&lt;b&gt;transcription-worker: match + assemble&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11;fontStyle=0;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="108" y="1562" width="250" height="40" as="geometry" />
        </mxCell>
        <mxCell id="p2-t14" value="One Aho-Corasick scan of the whole station index &amp;mdash; O(len(text)) regardless of keyword count &amp;mdash; and each hit resolves to &lt;b&gt;every&lt;/b&gt; campaign that registered it. Hits feed the per-station conversation assembler, which reaches back 30 s for context and closes on a 12 s gap, 300 s, disconnect or shutdown." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10;fontStyle=0;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="372" y="1560" width="1320" height="74" as="geometry" />
        </mxCell>
        <mxCell id="p2-e14" value="&amp;mdash; (in-memory state machine)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=9;fontStyle=0;fontColor=#4C7A0B;" vertex="1" parent="1">
          <mxGeometry x="1706" y="1560" width="530" height="74" as="geometry" />
        </mxCell>
        <mxCell id="p2-r15" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5DBE3;fontColor=#232F3E;fontSize=11;fontStyle=0;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="1648" width="2210" height="86" as="geometry" />
        </mxCell>
        <mxCell id="p2-b15" value="15" style="ellipse;whiteSpace=wrap;html=1;fillColor=#232F3E;strokeColor=#ffffff;strokeWidth=2;fontColor=#ffffff;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="54" y="1658" width="28" height="28" as="geometry" />
        </mxCell>
        <mxCell id="p2-a15" value="&lt;b&gt;transcription-worker &amp;rarr; SQLite&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11;fontStyle=0;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="108" y="1656" width="250" height="40" as="geometry" />
        </mxCell>
        <mxCell id="p2-t15" value="&lt;b&gt;ONE TXN:&lt;/b&gt; &lt;code&gt;conversation_sessions&lt;/code&gt; (closed) + stamp &lt;code&gt;transcripts.conversation_id&lt;/code&gt; + &lt;code&gt;outbox_events&lt;/code&gt; (queue=analysis). Only after this commits is the SQS message deleted. Then two small transactions mark the job succeeded and set &lt;code&gt;disposition&lt;/code&gt; to &lt;b&gt;retained&lt;/b&gt; (matched) or &lt;b&gt;disposable&lt;/b&gt; (no match) &amp;mdash; the flag cleanup keys on." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10;fontStyle=0;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="372" y="1654" width="1320" height="74" as="geometry" />
        </mxCell>
        <mxCell id="p2-e15" value="conversation_sessions, transcripts,&lt;br&gt;outbox_events, audio_segments" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=9;fontStyle=0;fontColor=#4C7A0B;" vertex="1" parent="1">
          <mxGeometry x="1706" y="1654" width="530" height="74" as="geometry" />
        </mxCell>
        <mxCell id="p2-phE" value="&lt;b&gt;E&lt;/b&gt; &amp;nbsp; Queue 2 &amp;rarr; analyse &amp;rarr; durable mention" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F0F7FF;strokeColor=#0B6AA8;fontColor=#0B6AA8;fontSize=12;fontStyle=0;align=left;verticalAlign=top;spacingLeft=12;spacingRight=12;spacingTop=4;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="1748" width="2210" height="30" as="geometry" />
        </mxCell>
        <mxCell id="p2-r16" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5DBE3;fontColor=#232F3E;fontSize=11;fontStyle=0;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="1786" width="2210" height="86" as="geometry" />
        </mxCell>
        <mxCell id="p2-b16" value="16" style="ellipse;whiteSpace=wrap;html=1;fillColor=#232F3E;strokeColor=#ffffff;strokeWidth=2;fontColor=#ffffff;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="54" y="1796" width="28" height="28" as="geometry" />
        </mxCell>
        <mxCell id="p2-a16" value="&lt;b&gt;planner &amp;rarr; SQS FIFO 2&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11;fontStyle=0;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="108" y="1794" width="250" height="40" as="geometry" />
        </mxCell>
        <mxCell id="p2-t16" value="The same single dispatcher sends the analysis job. &lt;code&gt;MessageGroupId=station_id&lt;/code&gt;, &lt;code&gt;MessageDeduplicationId=analysis_job_id&lt;/code&gt;. The message carries the matched-keyword evidence but &lt;b&gt;not&lt;/b&gt; the transcript." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10;fontStyle=0;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="372" y="1792" width="1320" height="74" as="geometry" />
        </mxCell>
        <mxCell id="p2-e16" value="outbox_events.status = sent" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=9;fontStyle=0;fontColor=#4C7A0B;" vertex="1" parent="1">
          <mxGeometry x="1706" y="1792" width="530" height="74" as="geometry" />
        </mxCell>
        <mxCell id="p2-r17" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5DBE3;fontColor=#232F3E;fontSize=11;fontStyle=0;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="1880" width="2210" height="86" as="geometry" />
        </mxCell>
        <mxCell id="p2-b17" value="17" style="ellipse;whiteSpace=wrap;html=1;fillColor=#232F3E;strokeColor=#ffffff;strokeWidth=2;fontColor=#ffffff;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="54" y="1890" width="28" height="28" as="geometry" />
        </mxCell>
        <mxCell id="p2-a17" value="&lt;b&gt;analysis-worker &amp;larr; SQS&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11;fontStyle=0;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="108" y="1888" width="250" height="40" as="geometry" />
        </mxCell>
        <mxCell id="p2-t17" value="Exactly one message per receive &amp;mdash; LLM work is serial on CPU and batching only adds latency. The conversation is reloaded from SQLite, so the analysed text is the committed text. A missing row is &lt;i&gt;retryable&lt;/i&gt;; zero matched keywords is &lt;i&gt;permanent&lt;/i&gt;." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10;fontStyle=0;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="372" y="1886" width="1320" height="74" as="geometry" />
        </mxCell>
        <mxCell id="p2-e17" value="&amp;mdash;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=9;fontStyle=0;fontColor=#4C7A0B;" vertex="1" parent="1">
          <mxGeometry x="1706" y="1886" width="530" height="74" as="geometry" />
        </mxCell>
        <mxCell id="p2-r18" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5DBE3;fontColor=#232F3E;fontSize=11;fontStyle=0;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="1974" width="2210" height="104" as="geometry" />
        </mxCell>
        <mxCell id="p2-b18" value="18" style="ellipse;whiteSpace=wrap;html=1;fillColor=#232F3E;strokeColor=#ffffff;strokeWidth=2;fontColor=#ffffff;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="54" y="1984" width="28" height="28" as="geometry" />
        </mxCell>
        <mxCell id="p2-a18" value="&lt;b&gt;analysis-worker &amp;rarr; LLM&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11;fontStyle=0;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="108" y="1982" width="250" height="40" as="geometry" />
        </mxCell>
        <mxCell id="p2-t18" value="Chain, best first: NVIDIA &amp;rarr; Ollama &amp;rarr; Groq &amp;rarr; Mistral &amp;rarr; Gemini &amp;rarr; local &lt;code&gt;llama-server&lt;/code&gt;. Any error, or a 200 whose body has no parseable JSON, cascades within the same call and rests that tier for 2 h. Output is untrusted: &lt;b&gt;every evidence quote must appear verbatim in the transcript&lt;/b&gt; or it is dropped, enumerations are coerced, &lt;code&gt;&amp;lt;think&amp;gt;&lt;/code&gt; blocks are stripped, and a failure degrades to a deterministic fallback rather than losing the mention." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10;fontStyle=0;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="372" y="1980" width="1320" height="92" as="geometry" />
        </mxCell>
        <mxCell id="p2-e18" value="&amp;mdash;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=9;fontStyle=0;fontColor=#4C7A0B;" vertex="1" parent="1">
          <mxGeometry x="1706" y="1980" width="530" height="92" as="geometry" />
        </mxCell>
        <mxCell id="p2-r19" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5DBE3;fontColor=#232F3E;fontSize=11;fontStyle=0;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="2086" width="2210" height="86" as="geometry" />
        </mxCell>
        <mxCell id="p2-b19" value="19" style="ellipse;whiteSpace=wrap;html=1;fillColor=#232F3E;strokeColor=#ffffff;strokeWidth=2;fontColor=#ffffff;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="54" y="2096" width="28" height="28" as="geometry" />
        </mxCell>
        <mxCell id="p2-a19" value="&lt;b&gt;analysis-worker &amp;rarr; SQLite&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11;fontStyle=0;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="108" y="2094" width="250" height="40" as="geometry" />
        </mxCell>
        <mxCell id="p2-t19" value="&lt;b&gt;ONE TXN:&lt;/b&gt; &lt;code&gt;mention_events&lt;/code&gt; (UNIQUE on conversation_id) + one &lt;code&gt;mention_campaigns&lt;/code&gt; row per campaign with its include/exclude verdict + one &lt;code&gt;mention_keywords&lt;/code&gt; row per keyword + &lt;code&gt;analysis_results&lt;/code&gt; + the inbox row. &lt;code&gt;mention_events&lt;/code&gt; has &lt;b&gt;no&lt;/b&gt; campaign_id column &amp;mdash; that is what makes &quot;analyse once, attribute many times&quot; true by construction." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10;fontStyle=0;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="372" y="2092" width="1320" height="74" as="geometry" />
        </mxCell>
        <mxCell id="p2-e19" value="mention_events, mention_campaigns,&lt;br&gt;mention_keywords, analysis_results,&lt;br&gt;inbox_messages" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=9;fontStyle=0;fontColor=#4C7A0B;" vertex="1" parent="1">
          <mxGeometry x="1706" y="2092" width="530" height="74" as="geometry" />
        </mxCell>
        <mxCell id="p2-r20" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5DBE3;fontColor=#232F3E;fontSize=11;fontStyle=0;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="2180" width="2210" height="86" as="geometry" />
        </mxCell>
        <mxCell id="p2-b20" value="20" style="ellipse;whiteSpace=wrap;html=1;fillColor=#232F3E;strokeColor=#ffffff;strokeWidth=2;fontColor=#ffffff;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="54" y="2190" width="28" height="28" as="geometry" />
        </mxCell>
        <mxCell id="p2-a20" value="&lt;b&gt;analysis-worker &amp;rarr; S3&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11;fontStyle=0;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="108" y="2188" width="250" height="40" as="geometry" />
        </mxCell>
        <mxCell id="p2-t20" value="Outside the transaction: three objects under &lt;code&gt;mentions/YYYY/MM/DD/&amp;lt;mention_id&amp;gt;/&lt;/code&gt; &amp;mdash; metadata, transcript, analysis &amp;mdash; with SSE-S3, then &lt;code&gt;result_s3_key&lt;/code&gt; is recorded. Allowed to fail: SQLite already holds what the API serves." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10;fontStyle=0;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="372" y="2186" width="1320" height="74" as="geometry" />
        </mxCell>
        <mxCell id="p2-e20" value="s3 mentions/&amp;hellip;&lt;br&gt;mention_events.result_s3_key" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=9;fontStyle=0;fontColor=#4C7A0B;" vertex="1" parent="1">
          <mxGeometry x="1706" y="2186" width="530" height="74" as="geometry" />
        </mxCell>
        <mxCell id="p2-r21" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5DBE3;fontColor=#232F3E;fontSize=11;fontStyle=0;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="2274" width="2210" height="86" as="geometry" />
        </mxCell>
        <mxCell id="p2-b21" value="21" style="ellipse;whiteSpace=wrap;html=1;fillColor=#232F3E;strokeColor=#ffffff;strokeWidth=2;fontColor=#ffffff;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="54" y="2284" width="28" height="28" as="geometry" />
        </mxCell>
        <mxCell id="p2-a21" value="&lt;b&gt;analysis-worker &amp;rarr; spool + S3&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11;fontStyle=0;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="108" y="2282" width="250" height="40" as="geometry" />
        </mxCell>
        <mxCell id="p2-t21" value="The conversation's retained segments are read back (a &lt;b&gt;second&lt;/b&gt; SHA-256 verification), stream-copied when formats match or re-encoded to Opus otherwise, and uploaded as one clip. &lt;code&gt;evidence_available&lt;/code&gt; flips to 1, which is what makes the audio routes work." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10;fontStyle=0;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="372" y="2280" width="1320" height="74" as="geometry" />
        </mxCell>
        <mxCell id="p2-e21" value="s3 evidence/YYYY/MM/DD/&amp;lt;id&amp;gt;.opus&lt;br&gt;mention_events.evidence_storage_key" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=9;fontStyle=0;fontColor=#4C7A0B;" vertex="1" parent="1">
          <mxGeometry x="1706" y="2280" width="530" height="74" as="geometry" />
        </mxCell>
        <mxCell id="p2-phF" value="&lt;b&gt;F&lt;/b&gt; &amp;nbsp; Retention and serving" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F2F7EC;strokeColor=#4C7A0B;fontColor=#4C7A0B;fontSize=12;fontStyle=0;align=left;verticalAlign=top;spacingLeft=12;spacingRight=12;spacingTop=4;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="2374" width="2210" height="30" as="geometry" />
        </mxCell>
        <mxCell id="p2-r22" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5DBE3;fontColor=#232F3E;fontSize=11;fontStyle=0;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="2412" width="2210" height="104" as="geometry" />
        </mxCell>
        <mxCell id="p2-b22" value="22" style="ellipse;whiteSpace=wrap;html=1;fillColor=#232F3E;strokeColor=#ffffff;strokeWidth=2;fontColor=#ffffff;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="54" y="2422" width="28" height="28" as="geometry" />
        </mxCell>
        <mxCell id="p2-a22" value="&lt;b&gt;cleanup-worker &amp;nbsp;+&amp;nbsp; api &amp;rarr; browser&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11;fontStyle=0;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="108" y="2420" width="250" height="40" as="geometry" />
        </mxCell>
        <mxCell id="p2-t22" value="&lt;b&gt;Cleanup&lt;/b&gt; deletes only what SQLite proves is safe: disposition &lt;code&gt;disposable&lt;/code&gt; past 10 min with the job succeeded/abandoned, or &lt;code&gt;failed&lt;/code&gt; past 24 h &amp;mdash; and never a segment a mention depends on. &lt;code&gt;pending&lt;/code&gt; and &lt;code&gt;retained&lt;/code&gt; are never deleted at any watermark. &amp;nbsp; &lt;b&gt;API&lt;/b&gt; serves &lt;code&gt;/dashboard&lt;/code&gt; and &lt;code&gt;/mentions&lt;/code&gt;, then mints an HMAC-SHA256 audio token (TTL 600 s, key allow-listed) that the browser exchanges for a Range-capable stream of the clip from S3." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10;fontStyle=0;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="372" y="2418" width="1320" height="92" as="geometry" />
        </mxCell>
        <mxCell id="p2-e22" value="audio_segments.disposition='deleted'&lt;br&gt;inbox_messages pruned (7 d)&lt;br&gt;HTTP 206 audio stream" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=9;fontStyle=0;fontColor=#4C7A0B;" vertex="1" parent="1">
          <mxGeometry x="1706" y="2418" width="530" height="92" as="geometry" />
        </mxCell>
        <mxCell id="p2-note" value="&lt;b&gt;Two honest notes about this pipeline as it stands at v0.4.1.&lt;/b&gt;&lt;br&gt;&amp;#9679; &lt;b&gt;ASR pass B is never invoked.&lt;/b&gt; &lt;code&gt;TranscriptionService.confirm()&lt;/code&gt; (wide beam, word timestamps, keyword-primed prompt) exists and is unit-tested, but no worker calls it. So &lt;code&gt;fuzzy&lt;/code&gt;, &lt;code&gt;phonetic&lt;/code&gt; and &lt;code&gt;semantic&lt;/code&gt; matches are flagged &lt;code&gt;requires_confirmation&lt;/code&gt; and then persisted &lt;i&gt;without&lt;/i&gt; a confirming second decode. No transcript row is ever written with &lt;code&gt;asr_pass='b'&lt;/code&gt;.&lt;br&gt;&amp;#9679; &lt;b&gt;The S3 publish backlog is not a recovery path yet.&lt;/b&gt; &lt;code&gt;_publish_backlog&lt;/code&gt; selects mentions with a NULL &lt;code&gt;result_s3_key&lt;/code&gt; and only logs the count &amp;mdash; it never re-publishes them. Evidence capture (step 21) &lt;i&gt;is&lt;/i&gt; retried properly by its own idle sweep." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFF6F6;strokeColor=#DD3522;fontColor=#232F3E;fontSize=10;fontStyle=0;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="2534" width="2210" height="92" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="page-cicd" name="3. CI/CD and deployment">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2320" pageHeight="1660" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p3-title" value="CI/CD &amp;mdash; GitHub &amp;rarr; OIDC &amp;rarr; SSM &amp;rarr; EC2" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=26;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="40" y="24" width="1700" height="34" as="geometry" />
        </mxCell>
        <mxCell id="p3-sub" value="&lt;b&gt;main is the only deployment source.&lt;/b&gt; A reviewed change lands on main, every protected check passes on that exact commit, and the commit deploys itself.&lt;br&gt;There is no SSH, no port 22, no EC2 key pair, no static AWS credential, and no input through which an arbitrary command can be sent." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;fontStyle=0;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="40" y="60" width="2100" height="44" as="geometry" />
        </mxCell>
        <mxCell id="p3-r0" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5DBE3;fontColor=#232F3E;fontSize=11;fontStyle=0;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="124" width="2210" height="120" as="geometry" />
        </mxCell>
        <mxCell id="p3-b0" value="D1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#3334B9;strokeColor=#ffffff;strokeWidth=2;fontColor=#ffffff;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="54" y="136" width="34" height="34" as="geometry" />
        </mxCell>
        <mxCell id="p3-a0" value="&lt;b&gt;GitHub Actions&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;fontStyle=0;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="100" y="134" width="250" height="40" as="geometry" />
        </mxCell>
        <mxCell id="p3-t0" value="A commit lands on &lt;code&gt;main&lt;/code&gt; &amp;mdash; the only deployment source. No staging branch, no release branch, no tag can trigger a deployment. &lt;b&gt;CI&lt;/b&gt; runs ruff, pytest on 3.11 and 3.12, and bandit + pip-audit; &lt;b&gt;CodeQL&lt;/b&gt; analyses Python in parallel." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10;fontStyle=0;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="364" y="132" width="1320" height="104" as="geometry" />
        </mxCell>
        <mxCell id="p3-e0" value="5 protected checks must exist:&lt;br&gt;Lint (ruff) &amp;middot; Tests 3.11 &amp;middot; Tests 3.12&lt;br&gt;Security (bandit + pip-audit) &amp;middot; Analyze Python" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=9;fontStyle=0;fontColor=#3334B9;" vertex="1" parent="1">
          <mxGeometry x="1698" y="132" width="540" height="104" as="geometry" />
        </mxCell>
        <mxCell id="p3-r1" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5DBE3;fontColor=#232F3E;fontSize=11;fontStyle=0;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="254" width="2210" height="120" as="geometry" />
        </mxCell>
        <mxCell id="p3-b1" value="D2" style="ellipse;whiteSpace=wrap;html=1;fillColor=#3334B9;strokeColor=#ffffff;strokeWidth=2;fontColor=#ffffff;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="54" y="266" width="34" height="34" as="geometry" />
        </mxCell>
        <mxCell id="p3-a1" value="&lt;b&gt;deploy-main.yml&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;fontStyle=0;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="100" y="264" width="250" height="40" as="geometry" />
        </mxCell>
        <mxCell id="p3-t1" value="Triggered by &lt;code&gt;workflow_run&lt;/code&gt; on CI completion (branch main), &lt;b&gt;not&lt;/b&gt; by push &amp;mdash; so a commit that failed CI can never deploy. Gates, in order: &lt;code&gt;AUTO_DEPLOY_ENABLED == &quot;1&quot;&lt;/code&gt;, conclusion success, event push, head_branch main, and the SHA must match &lt;code&gt;^[0-9a-f]{40}$&lt;/code&gt;. Then it polls the check-runs API for up to 30 minutes until &lt;b&gt;all five checks are green on that exact SHA&lt;/b&gt;." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10;fontStyle=0;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="364" y="262" width="1320" height="104" as="geometry" />
        </mxCell>
        <mxCell id="p3-e1" value="concurrency radio-production-main-deploy&lt;br&gt;cancel-in-progress: false&lt;br&gt;environment: production" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=9;fontStyle=0;fontColor=#3334B9;" vertex="1" parent="1">
          <mxGeometry x="1698" y="262" width="540" height="104" as="geometry" />
        </mxCell>
        <mxCell id="p3-r2" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5DBE3;fontColor=#232F3E;fontSize=11;fontStyle=0;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="384" width="2210" height="120" as="geometry" />
        </mxCell>
        <mxCell id="p3-b2" value="D3" style="ellipse;whiteSpace=wrap;html=1;fillColor=#3334B9;strokeColor=#ffffff;strokeWidth=2;fontColor=#ffffff;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="54" y="396" width="34" height="34" as="geometry" />
        </mxCell>
        <mxCell id="p3-a2" value="&lt;b&gt;OIDC &amp;rarr; STS&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;fontStyle=0;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="100" y="394" width="250" height="40" as="geometry" />
        </mxCell>
        <mxCell id="p3-t2" value="&lt;code&gt;aws-actions/configure-aws-credentials&lt;/code&gt;, pinned to a commit SHA, exchanges the GitHub OIDC token for short-lived STS credentials. The trust policy allows &lt;code&gt;sts:AssumeRoleWithWebIdentity&lt;/code&gt; only when &lt;code&gt;aud = sts.amazonaws.com&lt;/code&gt; and &lt;code&gt;sub = repo:&amp;lt;owner&amp;gt;/&amp;lt;repo&amp;gt;:environment:production&lt;/code&gt;. The workflow then asserts the returned ARN and account id are the expected ones." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10;fontStyle=0;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="364" y="392" width="1320" height="104" as="geometry" />
        </mxCell>
        <mxCell id="p3-e2" value="GitHubActionsRadioDeployRole&lt;br&gt;role-duration 7200 s&lt;br&gt;&lt;b&gt;id-token: write &amp;mdash; no secrets.* anywhere&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=9;fontStyle=0;fontColor=#3334B9;" vertex="1" parent="1">
          <mxGeometry x="1698" y="392" width="540" height="104" as="geometry" />
        </mxCell>
        <mxCell id="p3-r3" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5DBE3;fontColor=#232F3E;fontSize=11;fontStyle=0;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="514" width="2210" height="120" as="geometry" />
        </mxCell>
        <mxCell id="p3-b3" value="D4" style="ellipse;whiteSpace=wrap;html=1;fillColor=#3334B9;strokeColor=#ffffff;strokeWidth=2;fontColor=#ffffff;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="54" y="526" width="34" height="34" as="geometry" />
        </mxCell>
        <mxCell id="p3-a3" value="&lt;b&gt;SSM SendCommand&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;fontStyle=0;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="100" y="524" width="250" height="40" as="geometry" />
        </mxCell>
        <mxCell id="p3-t3" value="Verifies the instance is &lt;code&gt;Online&lt;/code&gt;, then verifies the pinned document version is numeric and matches &lt;code&gt;describe-document&lt;/code&gt; exactly &amp;mdash; &lt;code&gt;$LATEST&lt;/code&gt; and &lt;code&gt;$DEFAULT&lt;/code&gt; are explicitly forbidden. Sends &lt;b&gt;one&lt;/b&gt; parameter: the 40-hex commit. The role can call &lt;code&gt;ssm:SendCommand&lt;/code&gt; on only two documents and is explicitly &lt;b&gt;denied&lt;/b&gt; AWS-RunShellScript, StartSession, EC2 Instance Connect, iam:*, sts:AssumeRole, ec2:RunInstances, cloudformation:* and secretsmanager:*." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10;fontStyle=0;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="364" y="522" width="1320" height="104" as="geometry" />
        </mxCell>
        <mxCell id="p3-e3" value="RadioBroadcastDeployMain&lt;br&gt;--document-version &amp;lt;numeric&amp;gt;&lt;br&gt;--max-concurrency 1 --max-errors 0" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=9;fontStyle=0;fontColor=#3334B9;" vertex="1" parent="1">
          <mxGeometry x="1698" y="522" width="540" height="104" as="geometry" />
        </mxCell>
        <mxCell id="p3-r4" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5DBE3;fontColor=#232F3E;fontSize=11;fontStyle=0;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="644" width="2210" height="120" as="geometry" />
        </mxCell>
        <mxCell id="p3-b4" value="D5" style="ellipse;whiteSpace=wrap;html=1;fillColor=#3334B9;strokeColor=#ffffff;strokeWidth=2;fontColor=#ffffff;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="54" y="656" width="34" height="34" as="geometry" />
        </mxCell>
        <mxCell id="p3-a4" value="&lt;b&gt;SSM Agent on the host (root)&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;fontStyle=0;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="100" y="654" width="250" height="40" as="geometry" />
        </mxCell>
        <mxCell id="p3-t4" value="Reads the commit from the environment (&lt;code&gt;ENV_VAR&lt;/code&gt; interpolation, re-validated as 40 lower-case hex), requires &lt;code&gt;uname -m = aarch64&lt;/code&gt; and &lt;code&gt;/var/lib/radio&lt;/code&gt; to be a real mount point. Then, as &lt;code&gt;ec2-user&lt;/code&gt;: &lt;code&gt;git fetch&lt;/code&gt; only &amp;mdash; never pull, reset or checkout &amp;mdash; asserts &lt;code&gt;merge-base --is-ancestor &amp;lt;sha&amp;gt; origin/main&lt;/code&gt;, and &lt;code&gt;git archive&lt;/code&gt;s the commit to a temp dir before running its own &lt;code&gt;scripts/main-auto-deploy.sh&lt;/code&gt;." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10;fontStyle=0;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="364" y="652" width="1320" height="104" as="geometry" />
        </mxCell>
        <mxCell id="p3-e4" value="/var/lib/radio/logs/deployments/&lt;br&gt;deploy-&amp;lt;sha&amp;gt;-&amp;lt;stamp&amp;gt;.log (0600 root)&lt;br&gt;flock /var/lock/radio-main-auto-deploy.lock" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=9;fontStyle=0;fontColor=#3334B9;" vertex="1" parent="1">
          <mxGeometry x="1698" y="652" width="540" height="104" as="geometry" />
        </mxCell>
        <mxCell id="p3-r5" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5DBE3;fontColor=#232F3E;fontSize=11;fontStyle=0;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="774" width="2210" height="120" as="geometry" />
        </mxCell>
        <mxCell id="p3-b5" value="D6" style="ellipse;whiteSpace=wrap;html=1;fillColor=#3334B9;strokeColor=#ffffff;strokeWidth=2;fontColor=#ffffff;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="54" y="786" width="34" height="34" as="geometry" />
        </mxCell>
        <mxCell id="p3-a5" value="&lt;b&gt;main-auto-deploy.sh &amp;rarr; deploy-compose.sh&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;fontStyle=0;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="100" y="784" width="250" height="40" as="geometry" />
        </mxCell>
        <mxCell id="p3-t5" value="Nine stages: validate repo &amp;rarr; lock &amp;rarr; validate host (free space) &amp;rarr; host prerequisites (pinned Docker toolchain by SHA-256) &amp;rarr; runtime directories &amp;rarr; production config (created &lt;b&gt;once&lt;/b&gt;, never regenerating the token secret) &amp;rarr; first-install vs normal-update &amp;rarr; models (verify-first; a model that fails verification is never overwritten &amp;mdash; the deploy dies) &amp;rarr; deploy the stage. First install runs &lt;b&gt;api &amp;rarr; core &amp;rarr; full&lt;/b&gt; on the same commit, each fully verified before the next." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10;fontStyle=0;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="364" y="782" width="1320" height="104" as="geometry" />
        </mxCell>
        <mxCell id="p3-e5" value="stages: api &amp;rarr; core &amp;rarr; full&lt;br&gt;release id = &lt;b&gt;commit + stage&lt;/b&gt;&lt;br&gt;/var/lib/radio/releases/&amp;lt;sha&amp;gt;/&amp;lt;stage&amp;gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=9;fontStyle=0;fontColor=#3334B9;" vertex="1" parent="1">
          <mxGeometry x="1698" y="782" width="540" height="104" as="geometry" />
        </mxCell>
        <mxCell id="p3-gates" value="deploy-compose.sh &amp;mdash; 16 pre-flight gates, in order" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F5F5FE;strokeColor=#3334B9;fontColor=#3334B9;fontSize=13;fontStyle=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="916" width="1090" height="620" as="geometry" />
        </mxCell>
        <mxCell id="p3-gatesn" value="Gates 1&amp;ndash;13 leave the running release &lt;b&gt;completely untouched&lt;/b&gt;. Nothing is built, pulled or started until every one has passed." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=9;fontStyle=0;fontColor=#5A6C86;" vertex="1" parent="1">
          <mxGeometry x="58" y="946" width="1050" height="30" as="geometry" />
        </mxCell>
        <mxCell id="p3-g0" value="1 &amp;nbsp;tooling + sha256 present" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#DDDDF0;fontColor=#232F3E;fontSize=9;fontStyle=0;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="58" y="980" width="1050" height="22" as="geometry" />
        </mxCell>
        <mxCell id="p3-g1" value="2 &amp;nbsp;source repo readable, commit present, tree clean" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#DDDDF0;fontColor=#232F3E;fontSize=9;fontStyle=0;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="58" y="1004" width="1050" height="22" as="geometry" />
        </mxCell>
        <mxCell id="p3-g2" value="3 &amp;nbsp;flock /var/lock/radio-compose-deploy.lock" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#DDDDF0;fontColor=#232F3E;fontSize=9;fontStyle=0;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="58" y="1028" width="1050" height="22" as="geometry" />
        </mxCell>
        <mxCell id="p3-g3" value="4 &amp;nbsp;/var/lib/radio is a real mount point" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#DDDDF0;fontColor=#232F3E;fontSize=9;fontStyle=0;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="58" y="1052" width="1050" height="22" as="geometry" />
        </mxCell>
        <mxCell id="p3-g4" value="5 &amp;nbsp;source compose.env" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#DDDDF0;fontColor=#232F3E;fontSize=9;fontStyle=0;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="58" y="1076" width="1050" height="22" as="geometry" />
        </mxCell>
        <mxCell id="p3-g5" value="6 &amp;nbsp;resolve the host radio uid:gid" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#DDDDF0;fontColor=#232F3E;fontSize=9;fontStyle=0;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="58" y="1100" width="1050" height="22" as="geometry" />
        </mxCell>
        <mxCell id="p3-g6" value="7 &amp;nbsp;directory ownership is writable" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#DDDDF0;fontColor=#232F3E;fontSize=9;fontStyle=0;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="58" y="1124" width="1050" height="22" as="geometry" />
        </mxCell>
        <mxCell id="p3-g7" value="8 &amp;nbsp;env files exist, mode 600/640/400/440, no placeholder&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;secret, &lt;b&gt;no static AWS credential&lt;/b&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#DDDDF0;fontColor=#232F3E;fontSize=9;fontStyle=0;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="58" y="1148" width="1050" height="38" as="geometry" />
        </mxCell>
        <mxCell id="p3-g8" value="9 &amp;nbsp;validate the publish host" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#DDDDF0;fontColor=#232F3E;fontSize=9;fontStyle=0;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="58" y="1188" width="1050" height="22" as="geometry" />
        </mxCell>
        <mxCell id="p3-g9" value="10 free space: / 3072 MiB, /var/lib/radio 2048 MiB" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#DDDDF0;fontColor=#232F3E;fontSize=9;fontStyle=0;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="58" y="1212" width="1050" height="22" as="geometry" />
        </mxCell>
        <mxCell id="p3-g10" value="11 immutable release via git archive + manifest + secret-scan" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#DDDDF0;fontColor=#232F3E;fontSize=9;fontStyle=0;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="58" y="1236" width="1050" height="22" as="geometry" />
        </mxCell>
        <mxCell id="p3-g11" value="12 &lt;code&gt;docker compose config&lt;/code&gt; resolves" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#DDDDF0;fontColor=#232F3E;fontSize=9;fontStyle=0;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="58" y="1260" width="1050" height="22" as="geometry" />
        </mxCell>
        <mxCell id="p3-g12" value="13 verify-models.py against models.lock.json (full stage)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#DDDDF0;fontColor=#232F3E;fontSize=9;fontStyle=0;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="58" y="1284" width="1050" height="22" as="geometry" />
        </mxCell>
        <mxCell id="p3-g13" value="14 build images tagged &lt;b&gt;:&amp;lt;sha&amp;gt;&lt;/b&gt; &amp;mdash; never pulled" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#DDDDF0;fontColor=#232F3E;fontSize=9;fontStyle=0;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="58" y="1308" width="1050" height="22" as="geometry" />
        </mxCell>
        <mxCell id="p3-g14" value="14a validate config &lt;b&gt;inside the built image&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;(--network none, --read-only, --cap-drop ALL)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#DDDDF0;fontColor=#232F3E;fontSize=9;fontStyle=0;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="58" y="1332" width="1050" height="38" as="geometry" />
        </mxCell>
        <mxCell id="p3-g15" value="15 backup SQLite (.backup, integrity_check, S3) then migrate&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;in a one-shot --network none container" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#DDDDF0;fontColor=#232F3E;fontSize=9;fontStyle=0;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="58" y="1372" width="1050" height="38" as="geometry" />
        </mxCell>
        <mxCell id="p3-g16" value="16 &lt;code&gt;compose up -d --no-build --pull never&lt;/code&gt;, wait 300 s for&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;health, reconcile out-of-stage services" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#DDDDF0;fontColor=#232F3E;fontSize=9;fontStyle=0;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="58" y="1412" width="1050" height="38" as="geometry" />
        </mxCell>
        <mxCell id="p3-g17" value="&amp;#10003; smoke-test.sh against http://127.0.0.1:8788" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#DDDDF0;fontColor=#232F3E;fontSize=9;fontStyle=0;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="58" y="1452" width="1050" height="22" as="geometry" />
        </mxCell>
        <mxCell id="p3-g18" value="&amp;#10003; only now: flip current / previous symlinks, write state.json" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#DDDDF0;fontColor=#232F3E;fontSize=9;fontStyle=0;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="58" y="1476" width="1050" height="22" as="geometry" />
        </mxCell>
        <mxCell id="p3-rb" value="Rollback &amp;mdash; two mechanisms, one contract" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFF6F6;strokeColor=#DD3522;fontColor=#DD3522;fontSize=13;fontStyle=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="1160" y="916" width="1090" height="240" as="geometry" />
        </mxCell>
        <mxCell id="p3-rb1" value="&lt;b&gt;Automatic&lt;/b&gt; &amp;mdash; &lt;code&gt;restore_previous_release&lt;/code&gt; inside deploy-compose.sh. Runs only after containers were touched and only when a previous commit+stage exists. It deliberately does not call the operator script, which would deadlock on the lock this process already holds." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E8C4C4;fontColor=#232F3E;fontSize=9;fontStyle=0;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="1178" y="950" width="1054" height="62" as="geometry" />
        </mxCell>
        <mxCell id="p3-rb2" value="&lt;b&gt;Manual&lt;/b&gt; &amp;mdash; &lt;code&gt;scripts/rollback-compose.sh --previous&lt;/code&gt; or &lt;code&gt;--to-commit &amp;lt;sha&amp;gt;&lt;/code&gt;. Restores existing artifacts by moving a symlink." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E8C4C4;fontColor=#232F3E;fontSize=9;fontStyle=0;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="1178" y="1018" width="1054" height="50" as="geometry" />
        </mxCell>
        <mxCell id="p3-rb3" value="&lt;b&gt;Both restore code and images only. Neither ever restores the database.&lt;/b&gt; Reverting a SQLite file would discard every mention written since the backup, and the schema is forward-only by policy (ADR-004). A backup &lt;i&gt;is&lt;/i&gt; taken first; state records &lt;code&gt;&quot;migration&quot;: &quot;not-run (rollback)&quot;&lt;/code&gt; and &lt;code&gt;&quot;database_restored&quot;: false&lt;/code&gt;." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E8C4C4;fontColor=#232F3E;fontSize=9;fontStyle=0;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="1178" y="1074" width="1054" height="68" as="geometry" />
        </mxCell>
        <mxCell id="p3-ev" value="Evidence that there is no SSH and no static credential" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F7F8FA;strokeColor=#5A6C86;fontColor=#5A6C86;fontSize=13;fontStyle=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="1160" y="1178" width="1090" height="238" as="geometry" />
        </mxCell>
        <mxCell id="p3-ev0" value="&amp;#9679; IAM &lt;code&gt;Deny&lt;/code&gt; &amp;mdash; ssm:StartSession / ResumeSession / TerminateSession and both ec2-instance-connect SSH actions, on &lt;code&gt;*&lt;/code&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5DBE3;fontColor=#232F3E;fontSize=9;fontStyle=0;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="1178" y="1212" width="1054" height="30" as="geometry" />
        </mxCell>
        <mxCell id="p3-ev1" value="&amp;#9679; IAM &lt;code&gt;Deny&lt;/code&gt; &amp;mdash; ssm:SendCommand against AWS-RunShellScript, AWS-RunPowerShellScript, AWS-RunRemoteScript" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5DBE3;fontColor=#232F3E;fontSize=9;fontStyle=0;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="1178" y="1245" width="1054" height="30" as="geometry" />
        </mxCell>
        <mxCell id="p3-ev2" value="&amp;#9679; The role carries &lt;b&gt;no s3: and no sqs: permission at all&lt;/b&gt; &amp;mdash; those belong to the EC2 instance role, and a test asserts it" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5DBE3;fontColor=#232F3E;fontSize=9;fontStyle=0;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="1178" y="1278" width="1054" height="30" as="geometry" />
        </mxCell>
        <mxCell id="p3-ev3" value="&amp;#9679; &lt;code&gt;permissions: id-token: write&lt;/code&gt; and no &lt;code&gt;secrets.*&lt;/code&gt; reference anywhere in the deploy workflows" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5DBE3;fontColor=#232F3E;fontSize=9;fontStyle=0;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="1178" y="1311" width="1054" height="30" as="geometry" />
        </mxCell>
        <mxCell id="p3-ev4" value="&amp;#9679; &lt;code&gt;reject_static_aws_credentials()&lt;/code&gt; fails the deployment if an env file assigns AWS_ACCESS_KEY_ID / SECRET / SESSION_TOKEN" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5DBE3;fontColor=#232F3E;fontSize=9;fontStyle=0;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="1178" y="1344" width="1054" height="30" as="geometry" />
        </mxCell>
        <mxCell id="p3-ev5" value="&amp;#9679; The SSM document accepts exactly one parameter and no shell command" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5DBE3;fontColor=#232F3E;fontSize=9;fontStyle=0;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="1178" y="1377" width="1054" height="30" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>