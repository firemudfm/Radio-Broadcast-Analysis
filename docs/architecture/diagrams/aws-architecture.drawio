<mxfile host="app.diagrams.net" agent="Radio Broadcast Analysis" type="device" pages="3">
  <diagram id="page-arch" name="1. AWS architecture">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2960" pageHeight="2010" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p1-title" value="Radio Broadcast Analysis &amp;mdash; AWS architecture &amp;amp; backend pipeline" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=26;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="24" y="14" width="1900" height="34" as="geometry" />
        </mxCell>
        <mxCell id="p1-sub" value="One EC2 instance &amp;middot; 7 Docker Compose services &amp;middot; 2 SQS FIFO queues &amp;middot; SQLite (WAL) on EBS + S3 &amp;middot; deploy via GitHub OIDC &amp;rarr; SSM (no SSH)&lt;br&gt;&lt;b&gt;Black badges 1&amp;ndash;22&lt;/b&gt; = runtime data pipeline &amp;nbsp;&amp;nbsp;&lt;b&gt;Blue badges D1&amp;ndash;D6&lt;/b&gt; = deployment chain &amp;nbsp;&amp;nbsp;Every label is taken verbatim from the repository at v0.4.1." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;fontStyle=0;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="24" y="50" width="2200" height="46" as="geometry" />
        </mxCell>
        <mxCell id="p1-exthdr" value="OUTSIDE AWS" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;fontStyle=1;fontColor=#5A6C86;" vertex="1" parent="1">
          <mxGeometry x="24" y="108" width="316" height="22" as="geometry" />
        </mxCell>
        <mxCell id="p1-gh" value="GitHub" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F7F8FA;strokeColor=#5A6C86;fontColor=#5A6C86;fontSize=13;fontStyle=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="24" y="136" width="316" height="252" as="geometry" />
        </mxCell>
        <mxCell id="p1-gh1" value="&lt;b&gt;repository &amp;middot; branch &lt;code&gt;main&lt;/code&gt;&lt;/b&gt;&lt;br&gt;the only deployment source" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5DBE3;fontColor=#232F3E;fontSize=10;fontStyle=0;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="44" y="172" width="276" height="46" as="geometry" />
        </mxCell>
        <mxCell id="p1-gh2" value="&lt;b&gt;CI&lt;/b&gt; &amp;mdash; ruff &amp;middot; pytest 3.11 &amp;amp; 3.12&lt;br&gt;bandit -ll &amp;middot; pip-audit" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5DBE3;fontColor=#232F3E;fontSize=10;fontStyle=0;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="44" y="224" width="276" height="46" as="geometry" />
        </mxCell>
        <mxCell id="p1-gh3" value="&lt;b&gt;CodeQL&lt;/b&gt; &amp;mdash; Analyze Python" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5DBE3;fontColor=#232F3E;fontSize=10;fontStyle=0;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="44" y="276" width="276" height="40" as="geometry" />
        </mxCell>
        <mxCell id="p1-gh4" value="&lt;b&gt;deploy-main.yml&lt;/b&gt;&lt;br&gt;workflow_run &amp;rarr; OIDC &amp;rarr; SSM&lt;br&gt;gate: all 5 checks green on that SHA" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5DBE3;fontColor=#232F3E;fontSize=10;fontStyle=0;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="44" y="322" width="276" height="52" as="geometry" />
        </mxCell>
        <mxCell id="p1-streams" value="&lt;b&gt;Live radio streams&lt;/b&gt;&lt;br&gt;internet stations &amp;middot; MP3 / AAC / HLS / Ogg&lt;br&gt;URLs are UNTRUSTED &amp;mdash; SSRF-validated on&lt;br&gt;every connect and every redirect hop" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7D8998;fontColor=#232F3E;fontSize=10;fontStyle=0;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="24" y="412" width="316" height="118" as="geometry" />
        </mxCell>
        <mxCell id="p1-inet" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#232F3D;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.internet_alt1;" vertex="1" parent="1">
          <mxGeometry x="246" y="432" width="78" height="48" as="geometry" />
        </mxCell>
        <mxCell id="p1-rb" value="&lt;b&gt;Radio Browser API&lt;/b&gt;&lt;br&gt;community catalogue &amp;middot; mirror pool&lt;br&gt;SRV discovery &amp;middot; &lt;code&gt;/json/url/&amp;lt;uuid&amp;gt;&lt;/code&gt;&lt;br&gt;resolved URL is cached &amp;mdash; asked once per station" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7D8998;fontColor=#232F3E;fontSize=10;fontStyle=0;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="24" y="550" width="316" height="118" as="geometry" />
        </mxCell>
        <mxCell id="p1-cons" value="Consumers" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F7F8FA;strokeColor=#5A6C86;fontColor=#5A6C86;fontSize=13;fontStyle=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="24" y="688" width="316" height="176" as="geometry" />
        </mxCell>
        <mxCell id="p1-user" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#232F3D;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.user;" vertex="1" parent="1">
          <mxGeometry x="54" y="726" width="78" height="78" as="geometry" />
        </mxCell>
        <mxCell id="p1-cons1" value="&lt;b&gt;Dashboard&lt;/b&gt;&lt;br&gt;browser SPA (CORS)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5DBE3;fontColor=#232F3E;fontSize=10;fontStyle=0;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="148" y="726" width="172" height="46" as="geometry" />
        </mxCell>
        <mxCell id="p1-cons2" value="&lt;b&gt;Operator&lt;/b&gt;&lt;br&gt;curl / Swagger &lt;code&gt;/docs&lt;/code&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5DBE3;fontColor=#232F3E;fontSize=10;fontStyle=0;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="148" y="780" width="172" height="46" as="geometry" />
        </mxCell>
        <mxCell id="p1-cons3" value="pilot is unauthenticated (&lt;code&gt;auth_mode: none&lt;/code&gt;) &amp;mdash; reachable only from the security-group CIDR" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=9;fontStyle=0;fontColor=#DD3522;" vertex="1" parent="1">
          <mxGeometry x="44" y="830" width="286" height="26" as="geometry" />
        </mxCell>
        <mxCell id="p1-leg" value="Legend" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F7F8FA;strokeColor=#5A6C86;fontColor=#5A6C86;fontSize=13;fontStyle=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="24" y="886" width="316" height="452" as="geometry" />
        </mxCell>
        <mxCell id="p1-legb1" value="7" style="ellipse;whiteSpace=wrap;html=1;fillColor=#232F3E;strokeColor=#ffffff;strokeWidth=2;fontColor=#ffffff;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="44" y="922" width="28" height="28" as="geometry" />
        </mxCell>
        <mxCell id="p1-legt1" value="runtime pipeline step (1&amp;ndash;22)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10;fontStyle=0;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="82" y="922" width="248" height="28" as="geometry" />
        </mxCell>
        <mxCell id="p1-legb2" value="D" style="ellipse;whiteSpace=wrap;html=1;fillColor=#3334B9;strokeColor=#ffffff;strokeWidth=2;fontColor=#ffffff;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="44" y="958" width="28" height="28" as="geometry" />
        </mxCell>
        <mxCell id="p1-legt2" value="deployment step (D1&amp;ndash;D6)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10;fontStyle=0;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="82" y="958" width="248" height="28" as="geometry" />
        </mxCell>
        <mxCell id="p1-legl1" value="&lt;b&gt;&amp;#9473;&amp;#9473;&lt;/b&gt; data path (audio, messages, rows)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10;fontStyle=0;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="44" y="998" width="286" height="22" as="geometry" />
        </mxCell>
        <mxCell id="p1-legl2" value="&lt;b&gt;&amp;#9476;&amp;#9476;&lt;/b&gt; control / deploy path" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10;fontStyle=0;fontColor=#3334B9;" vertex="1" parent="1">
          <mxGeometry x="44" y="1022" width="286" height="22" as="geometry" />
        </mxCell>
        <mxCell id="p1-legl3" value="&lt;b&gt;&amp;#9473;&amp;#9473;&lt;/b&gt; S3 export / read-back" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10;fontStyle=0;fontColor=#7AA116;" vertex="1" parent="1">
          <mxGeometry x="44" y="1046" width="286" height="22" as="geometry" />
        </mxCell>
        <mxCell id="p1-legtx" value="&lt;b&gt;ONE TXN&lt;/b&gt; marks a single SQLite transaction. Business rows and the outbox row commit together &amp;mdash; that is the whole reliability argument (ADR-009)." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5DBE3;fontColor=#232F3E;fontSize=9;fontStyle=0;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="44" y="1078" width="286" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p1-legsec" value="&lt;b&gt;Every container:&lt;/b&gt; non-root &amp;middot; &lt;code&gt;cap_drop: ALL&lt;/code&gt; &amp;middot; &lt;code&gt;no-new-privileges&lt;/code&gt; &amp;middot; read-only root fs &amp;middot; tmpfs &lt;code&gt;/tmp&lt;/code&gt; &amp;middot; &lt;code&gt;pids: 256&lt;/code&gt; &amp;middot; rotated json-file logs. Never privileged, never host networking, never the Docker socket." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5DBE3;fontColor=#232F3E;fontSize=9;fontStyle=0;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="44" y="1146" width="286" height="76" as="geometry" />
        </mxCell>
        <mxCell id="p1-legcap" value="&lt;b&gt;Capacity &amp;mdash; four different numbers&lt;/b&gt;&lt;br&gt;catalogue stations 1,000+&lt;br&gt;&lt;b&gt;requested&lt;/b&gt; unique stations 1,000 (load-proven)&lt;br&gt;&lt;b&gt;active&lt;/b&gt; unique stations 1 by code default; 512 in the prod template with &lt;code&gt;RADIO_ALLOW_UNBENCHMARKED_CAPACITY=1&lt;/code&gt;&lt;br&gt;real-time ASR throughput &lt;b&gt;never benchmarked&lt;/b&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5DBE3;fontColor=#232F3E;fontSize=9;fontStyle=0;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="44" y="1230" width="286" height="96" as="geometry" />
        </mxCell>
        <mxCell id="p1-facts" value="Runtime facts" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F7F8FA;strokeColor=#5A6C86;fontColor=#5A6C86;fontSize=13;fontStyle=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="24" y="1358" width="316" height="542" as="geometry" />
        </mxCell>
        <mxCell id="p1-f1" value="&lt;b&gt;Host&lt;/b&gt;&lt;br&gt;EC2 Graviton, aarch64, 8 vCPU / 16 GiB&lt;br&gt;(c7g / c8g.2xlarge class)&lt;br&gt;deploy refuses any non-aarch64 host&lt;br&gt;instance role supplies AWS credentials" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5DBE3;fontColor=#232F3E;fontSize=9;fontStyle=0;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="44" y="1394" width="276" height="88" as="geometry" />
        </mxCell>
        <mxCell id="p1-f2" value="&lt;b&gt;Container limits (compose.prod.yaml)&lt;/b&gt;&lt;br&gt;api 1.0 CPU / 512 MiB&lt;br&gt;planner 0.5 / 256&lt;br&gt;listener 1.5 / 1024&lt;br&gt;transcription-worker 3.0 / 3072&lt;br&gt;analysis-worker 0.75 / 512&lt;br&gt;cleanup-worker 0.25 / 256&lt;br&gt;llm 3.0 / 4096 &amp;nbsp;&amp;mdash;&amp;nbsp; total 9,728 MiB" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5DBE3;fontColor=#232F3E;fontSize=9;fontStyle=0;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="44" y="1490" width="276" height="132" as="geometry" />
        </mxCell>
        <mxCell id="p1-f3" value="&lt;b&gt;Models (never in an image, never auto-downloaded)&lt;/b&gt;&lt;br&gt;ASR &lt;code&gt;Systran/faster-whisper-small&lt;/code&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;CTranslate2, int8, CPU, beam 1&lt;br&gt;VAD &lt;code&gt;silero_vad.onnx&lt;/code&gt;&lt;br&gt;LLM &lt;code&gt;Qwen3-0.6B-Q8_0.gguf&lt;/code&gt;&lt;br&gt;pinned + digest-verified via models.lock.json" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5DBE3;fontColor=#232F3E;fontSize=9;fontStyle=0;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="44" y="1630" width="276" height="116" as="geometry" />
        </mxCell>
        <mxCell id="p1-f4" value="&lt;b&gt;Known gaps &amp;mdash; documented, not defects&lt;/b&gt;&lt;br&gt;&amp;bull; ASR &lt;b&gt;pass B&lt;/b&gt; exists and is unit-tested but &lt;b&gt;no worker calls it&lt;/b&gt;, so fuzzy/phonetic candidates are never re-decoded&lt;br&gt;&amp;bull; &lt;code&gt;_publish_backlog&lt;/code&gt; logs only; it does not re-publish&lt;br&gt;&amp;bull; nothing writes &lt;code&gt;campaign_content_policies&lt;/code&gt;&lt;br&gt;&amp;bull; &lt;code&gt;temp-transcripts/&lt;/code&gt; and &lt;code&gt;config/&lt;/code&gt; prefixes are dead settings" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFF6F6;strokeColor=#DD3522;fontColor=#232F3E;fontSize=9;fontStyle=0;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="44" y="1754" width="276" height="130" as="geometry" />
        </mxCell>
        <mxCell id="p1-cloud" value="AWS Cloud" style="points=[[0,0],[0.25,0],[0.5,0],[0.75,0],[1,0],[1,0.25],[1,0.5],[1,0.75],[1,1],[0.75,1],[0.5,1],[0.25,1],[0,1],[0,0.75],[0,0.5],[0,0.25]];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=13;fontStyle=1;container=0;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_aws_cloud_alt;strokeColor=#232F3E;fillColor=none;verticalAlign=top;align=left;spacingLeft=34;fontColor=#232F3E;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="370" y="110" width="2150" height="1840" as="geometry" />
        </mxCell>
        <mxCell id="p1-region" value="Region &amp;mdash; eu-north-1 (default)" style="points=[[0,0],[0.25,0],[0.5,0],[0.75,0],[1,0],[1,0.25],[1,0.5],[1,0.75],[1,1],[0.75,1],[0.5,1],[0.25,1],[0,1],[0,0.75],[0,0.5],[0,0.25]];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=13;fontStyle=1;container=0;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_region;strokeColor=#00A4A6;fillColor=none;verticalAlign=top;align=left;spacingLeft=34;fontColor=#147EBA;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="400" y="155" width="2090" height="1770" as="geometry" />
        </mxCell>
        <mxCell id="p1-laned" value="Deployment &amp;mdash; GitHub OIDC &amp;rarr; fixed SSM document &amp;rarr; immutable release &amp;nbsp;|&amp;nbsp; no SSH, no port 22, no EC2 key pair, no static AWS credential" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F5F5FE;strokeColor=#3334B9;fontColor=#3334B9;fontSize=13;fontStyle=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="430" y="200" width="2030" height="210" as="geometry" />
        </mxCell>
        <mxCell id="p1-d1" value="" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#DD344C;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.identity_and_access_management;" vertex="1" parent="1">
          <mxGeometry x="520" y="244" width="78" height="78" as="geometry" />
        </mxCell>
        <mxCell id="p1-d1lbl" value="&lt;b&gt;IAM &amp;middot; OIDC provider&lt;/b&gt;&lt;br&gt;&lt;code&gt;token.actions.githubusercontent.com&lt;/code&gt;&lt;br&gt;ClientId &lt;code&gt;sts.amazonaws.com&lt;/code&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5DBE3;fontColor=#232F3E;fontSize=9;fontStyle=0;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="440" y="328" width="238" height="74" as="geometry" />
