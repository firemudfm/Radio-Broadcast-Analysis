          <mxGeometry x="1122" y="1602" width="310" height="118" as="geometry" />
        </mxCell>
        <mxCell id="p1-tb2t" value="&lt;b&gt;Capture &amp;amp; ASR&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10;fontStyle=0;fontColor=#C925D1;" vertex="1" parent="1">
          <mxGeometry x="1132" y="1608" width="290" height="20" as="geometry" />
        </mxCell>
        <mxCell id="p1-tb2b" value="station_sessions&lt;br&gt;audio_segments&lt;br&gt;transcription_jobs&lt;br&gt;transcripts" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=9;fontStyle=0;fontColor=#232F3E;" vertex="1" parent="1">
