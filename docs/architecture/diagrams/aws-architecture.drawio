        <mxCell id="p1-analysist" value="&lt;b&gt;analysis-worker&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=13;fontStyle=0;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="1424" y="668" width="304" height="26" as="geometry" />
        </mxCell>
        <mxCell id="p1-analysisb" value="&amp;#9679; receive exactly &lt;b&gt;1&lt;/b&gt; (LLM is serial on CPU)&lt;br&gt;&amp;#9679; conversation reloaded from SQLite &amp;mdash; transcripts&lt;br&gt;&amp;nbsp;&amp;nbsp;travel by &lt;b&gt;reference&lt;/b&gt;, never inside a message&lt;br&gt;&amp;#9679; LLM chain &amp;rarr; validated JSON; evidence must be a&lt;br&gt;&amp;nbsp;&amp;nbsp;&lt;b&gt;verbatim transcript substring&lt;/b&gt; or it is dropped&lt;br&gt;&amp;#9679; fan-out 1 mention : N campaigns : N keywords&lt;br&gt;&amp;#9679; evidence clip cut from retained spool segments&lt;br&gt;&amp;#9679; idle sweeps: clip backfill (3/tick) and&lt;br&gt;&amp;nbsp;&amp;nbsp;fallback re-analysis healing (2/tick)&lt;br&gt;&amp;#9679; never fails a message &amp;mdash; degrades to fallback&lt;br&gt;&lt;i&gt;0.75 CPU &amp;middot; 512 MiB &amp;middot; tmpfs /tmp 256 MiB&lt;/i&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=9;fontStyle=0;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="1380" y="704" width="346" height="188" as="geometry" />
        </mxCell>
        <mxCell id="p1-api" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFF8F2;strokeColor=#ED7100;fontColor=#232F3E;fontSize=11;fontStyle=0;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;dashed=0;" vertex="1" parent="1">
