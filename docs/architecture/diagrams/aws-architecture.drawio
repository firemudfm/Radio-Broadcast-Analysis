        </mxCell>
        <mxCell id="p1-tb3t" value="&lt;b&gt;Analysis &amp;amp; attribution&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10;fontStyle=0;fontColor=#C925D1;" vertex="1" parent="1">
          <mxGeometry x="1467" y="1608" width="290" height="20" as="geometry" />
        </mxCell>
        <mxCell id="p1-tb3b" value="conversation_sessions&lt;br&gt;mention_events &lt;i&gt;(no campaign_id column)&lt;/i&gt;&lt;br&gt;mention_campaigns &amp;middot; mention_keywords&lt;br&gt;analysis_results" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=9;fontStyle=0;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="1467" y="1630" width="290" height="84" as="geometry" />
        </mxCell>
        <mxCell id="p1-tb4" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E5C7EA;fontColor=#232F3E;fontSize=11;fontStyle=0;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="1792" y="1602" width="310" height="118" as="geometry" />
        </mxCell>
        <mxCell id="p1-tb4t" value="&lt;b&gt;Reliability&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10;fontStyle=0;fontColor=#C925D1;" vertex="1" parent="1">
          <mxGeometry x="1802" y="1608" width="290" height="20" as="geometry" />
        </mxCell>
        <mxCell id="p1-tb4b" value="outbox_events&lt;br&gt;inbox_messages&lt;br&gt;worker_heartbeats&lt;br&gt;processing_failures" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=9;fontStyle=0;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="1802" y="1630" width="290" height="84" as="geometry" />
        </mxCell>
        <mxCell id="p1-tb5" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E5C7EA;fontColor=#232F3E;fontSize=11;fontStyle=0;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="2127" y="1602" width="310" height="118" as="geometry" />
        </mxCell>
        <mxCell id="p1-tb5t" value="&lt;b&gt;Catalogue (v0.4)&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10;fontStyle=0;fontColor=#C925D1;" vertex="1" parent="1">
          <mxGeometry x="2137" y="1608" width="290" height="20" as="geometry" />
        </mxCell>
        <mxCell id="p1-tb5b" value="managed_stations&lt;br&gt;radio_catalog_overrides / _deletions&lt;br&gt;station_jobs &amp;middot; station_probe_results&lt;br&gt;campaign_station_members" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=9;fontStyle=0;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="2137" y="1630" width="290" height="84" as="geometry" />
        </mxCell>
        <mxCell id="p1-rel" value="Reliability model &amp;mdash; how work survives a crash, a redelivery or a wedged dependency" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F7F8FA;strokeColor=#5A6C86;fontColor=#5A6C86;fontSize=13;fontStyle=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="430" y="1770" width="2030" height="130" as="geometry" />
        </mxCell>
        <mxCell id="p1-rl0" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5DBE3;fontColor=#232F3E;fontSize=11;fontStyle=0;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="452" y="1812" width="480" height="76" as="geometry" />
        </mxCell>
        <mxCell id="p1-rl0t" value="&lt;b&gt;Transactional outbox&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10;fontStyle=0;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="462" y="1816" width="460" height="18" as="geometry" />
        </mxCell>
        <mxCell id="p1-rl0b" value="Producers never call SQS. They INSERT into &lt;code&gt;outbox_events&lt;/code&gt; inside the same transaction as the business rows; the &lt;b&gt;planner&lt;/b&gt; is the single dispatcher. Closes the &quot;committed but never queued&quot; silent stall." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=8;fontStyle=0;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="462" y="1836" width="460" height="48" as="geometry" />
        </mxCell>
        <mxCell id="p1-rl1" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5DBE3;fontColor=#232F3E;fontSize=11;fontStyle=0;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="954" y="1812" width="480" height="76" as="geometry" />
        </mxCell>
        <mxCell id="p1-rl1t" value="&lt;b&gt;Consumer inbox&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10;fontStyle=0;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="964" y="1816" width="460" height="18" as="geometry" />
        </mxCell>
        <mxCell id="p1-rl1b" value="Business result + &lt;code&gt;inbox_messages&lt;/code&gt; row commit together, &lt;b&gt;then&lt;/b&gt; the SQS message is deleted. A crash in between redelivers, and the inbox turns the redelivery into a no-op. Every insert is UNIQUE-guarded." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=8;fontStyle=0;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="964" y="1836" width="460" height="48" as="geometry" />
        </mxCell>
        <mxCell id="p1-rl2" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5DBE3;fontColor=#232F3E;fontSize=11;fontStyle=0;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="1456" y="1812" width="480" height="76" as="geometry" />
        </mxCell>
        <mxCell id="p1-rl2t" value="&lt;b&gt;Leases &amp;amp; heartbeats&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10;fontStyle=0;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="1466" y="1816" width="460" height="18" as="geometry" />
        </mxCell>
        <mxCell id="p1-rl2b" value="Visibility 300 s extended every 60 s up to 1800 s. &lt;code&gt;worker_heartbeats&lt;/code&gt; lets &lt;code&gt;/readyz&lt;/code&gt; tell &quot;never ran&quot; from &quot;died 4 minutes ago&quot;. A stale-job sweeper reclaims work whose worker was killed mid-flight." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=8;fontStyle=0;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="1466" y="1836" width="460" height="48" as="geometry" />
        </mxCell>
        <mxCell id="p1-rl3" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5DBE3;fontColor=#232F3E;fontSize=11;fontStyle=0;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="1958" y="1812" width="480" height="76" as="geometry" />
        </mxCell>
        <mxCell id="p1-rl3t" value="&lt;b&gt;Error taxonomy&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10;fontStyle=0;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="1968" y="1816" width="460" height="18" as="geometry" />
        </mxCell>
        <mxCell id="p1-rl3b" value="Retryability is a property of the exception &lt;i&gt;type&lt;/i&gt;, not a per-call-site decision. Retryable &amp;rarr; leave the message. Permanent &amp;rarr; record in &lt;code&gt;processing_failures&lt;/code&gt;, write the inbox row, delete the message." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=8;fontStyle=0;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="1968" y="1836" width="460" height="48" as="geometry" />
