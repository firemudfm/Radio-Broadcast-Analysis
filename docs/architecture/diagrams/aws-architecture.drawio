        <mxCell id="p1-t3" value="&lt;b&gt;4.&lt;/b&gt; Mistral &amp;nbsp;&lt;i&gt;ministral-8b-latest&lt;/i&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F7F8FA;strokeColor=#D5DBE3;fontColor=#232F3E;fontSize=9;fontStyle=0;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;dashed=0;" vertex="1" parent="1">
