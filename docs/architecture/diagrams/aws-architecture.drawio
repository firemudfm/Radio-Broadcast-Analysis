        </mxCell>
        <mxCell id="p1-transcriptiont" value="&lt;b&gt;transcription-worker&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=13;fontStyle=0;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="1014" y="668" width="306" height="26" as="geometry" />
        </mxCell>
        <mxCell id="p1-transcriptionb" value="&amp;#9679; receive &amp;le;5 &amp;middot; long-poll 20 s&lt;br&gt;&amp;nbsp;&amp;nbsp;visibility 300 s, heartbeat every 60 s, cap 1800 s&lt;br&gt;&amp;#9679; inbox pre-check &amp;rarr; duplicate deleted, not decoded&lt;br&gt;&amp;#9679; job older than 6 h &amp;rarr; &lt;code&gt;abandoned&lt;/code&gt;, no decode&lt;br&gt;&amp;#9679; &lt;b&gt;SHA-256 verified before any decoder sees bytes&lt;/b&gt;&lt;br&gt;&amp;#9679; ASR pass A &amp;mdash; faster-whisper small, int8, beam 1&lt;br&gt;&amp;#9679; Aho-Corasick scan &lt;b&gt;once&lt;/b&gt; vs the station's&lt;br&gt;&amp;nbsp;&amp;nbsp;COMBINED index &amp;rarr; every campaign attributed&lt;br&gt;&amp;#9679; conversation assembler: 30 s pre-roll, closes on&lt;br&gt;&amp;nbsp;&amp;nbsp;12 s gap / 300 s / disconnect / shutdown&lt;br&gt;&lt;i&gt;3.0 CPU &amp;middot; 3072 MiB &amp;middot; 3 ASR threads&lt;/i&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=9;fontStyle=0;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="970" y="704" width="348" height="188" as="geometry" />
        </mxCell>
