        </mxCell>
        <mxCell id="p1-listenerb" value="one async session per &lt;b&gt;DISTINCT&lt;/b&gt; station&lt;br&gt;&amp;#9679; SSRF re-validate &amp;rarr; ffmpeg &amp;rarr; 16 kHz mono s16le&lt;br&gt;&amp;nbsp;&amp;nbsp;&lt;code&gt;-reconnect 0&lt;/code&gt;, &lt;code&gt;-protocol_whitelist&lt;/code&gt; (no file/concat)&lt;br&gt;&amp;#9679; ring buffer 60 s = 1,920,000 B / station&lt;br&gt;&amp;nbsp;&amp;nbsp;timestamps from sample count, not wall clock&lt;br&gt;&amp;#9679; VAD + energy classifier, 3 s windows&lt;br&gt;&amp;nbsp;&amp;nbsp;silence / music / singing discarded &lt;b&gt;in RAM&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;uncertain is KEPT (recall &amp;gt; CPU)&lt;br&gt;&amp;#9679; 20 s segments, 1 s overlap &amp;rarr; Opus 24k voip&lt;br&gt;&amp;#9679; spool write: tmp &amp;rarr; fsync &amp;rarr; os.replace &amp;rarr; sha256&lt;br&gt;&lt;i&gt;1.5 CPU &amp;middot; 1024 MiB &amp;middot; stop_grace 30 s&lt;/i&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=9;fontStyle=0;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="560" y="704" width="348" height="188" as="geometry" />
        </mxCell>
        <mxCell id="p1-transcription" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFF8F2;strokeColor=#ED7100;fontColor=#232F3E;fontSize=11;fontStyle=0;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;dashed=0;" vertex="1" parent="1">
