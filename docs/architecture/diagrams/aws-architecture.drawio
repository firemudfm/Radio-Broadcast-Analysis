        </mxCell>
        <mxCell id="p1-t4" value="&lt;b&gt;5.&lt;/b&gt; Gemini &amp;nbsp;&lt;i&gt;gemini-flash-latest&lt;/i&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F7F8FA;strokeColor=#D5DBE3;fontColor=#232F3E;fontSize=9;fontStyle=0;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="2570" y="480" width="280" height="30" as="geometry" />
        </mxCell>
        <mxCell id="p1-hostedn" value="Any error &amp;mdash; or a 200 with unparseable content &amp;mdash; cascades to the next tier &lt;b&gt;inside the same call&lt;/b&gt;; the failed tier rests 2 h. The local model is the end of the chain." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=8;fontStyle=0;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="2570" y="534" width="280" height="44" as="geometry" />
        </mxCell>
        <mxCell id="p1-sqs" value="Amazon SQS &amp;mdash; two FIFO queues (metadata and references only; never audio bytes, never a transcript body, never a credential)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFF5FA;strokeColor=#E7157B;fontColor=#E7157B;fontSize=13;fontStyle=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="430" y="1270" width="2030" height="250" as="geometry" />
        </mxCell>
        <mxCell id="p1-sqsi" value="" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.sqs;" vertex="1" parent="1">
          <mxGeometry x="460" y="1322" width="58" height="58" as="geometry" />
        </mxCell>
        <mxCell id="p1-sqsit" value="Amazon SQS" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=9;fontStyle=0;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="452" y="1386" width="100" height="40" as="geometry" />
        </mxCell>
        <mxCell id="p1-q1" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#F0B6D2;fontColor=#232F3E;fontSize=11;fontStyle=0;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="570" y="1318" width="920" height="128" as="geometry" />
        </mxCell>
        <mxCell id="p1-q1i" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#E7157B;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.queue;" vertex="1" parent="1">
          <mxGeometry x="592" y="1352" width="78" height="47" as="geometry" />
        </mxCell>
        <mxCell id="p1-q1t" value="&lt;b&gt;RADIO_TRANSCRIPTION_QUEUE_URL&lt;/b&gt; &amp;nbsp;&lt;i&gt;&amp;hellip;/&amp;lt;name&amp;gt;.fifo&lt;/i&gt;&lt;br&gt;schema &lt;code&gt;radio.transcription.v1&lt;/code&gt; &amp;middot; body &amp;le; 64 KiB (self-imposed, ~16&amp;times; below the SQS limit)&lt;br&gt;&lt;b&gt;MessageGroupId = station_id&lt;/b&gt; &amp;rarr; a station's segments stay ordered, one in flight per station&lt;br&gt;&lt;b&gt;MessageDeduplicationId = segment_id&lt;/b&gt;&lt;br&gt;producer: &lt;b&gt;planner&lt;/b&gt; outbox dispatcher &amp;nbsp;&amp;middot;&amp;nbsp; consumer: &lt;b&gt;transcription-worker&lt;/b&gt; (&amp;le;5 per receive)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=9;fontStyle=0;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="686" y="1328" width="790" height="112" as="geometry" />
        </mxCell>
        <mxCell id="p1-q2" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#F0B6D2;fontColor=#232F3E;fontSize=11;fontStyle=0;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="1510" y="1318" width="920" height="128" as="geometry" />
        </mxCell>
        <mxCell id="p1-q2i" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#E7157B;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.queue;" vertex="1" parent="1">
          <mxGeometry x="1532" y="1352" width="78" height="47" as="geometry" />
        </mxCell>
        <mxCell id="p1-q2t" value="&lt;b&gt;RADIO_ANALYSIS_QUEUE_URL&lt;/b&gt; &amp;nbsp;&lt;i&gt;&amp;hellip;/&amp;lt;name&amp;gt;.fifo&lt;/i&gt;&lt;br&gt;schema &lt;code&gt;radio.analysis.v1&lt;/code&gt; &amp;middot; carries the matched-keyword evidence, not the transcript&lt;br&gt;&lt;b&gt;MessageGroupId = station_id&lt;/b&gt;&lt;br&gt;&lt;b&gt;MessageDeduplicationId = analysis_job_id&lt;/b&gt;&lt;br&gt;producer: &lt;b&gt;planner&lt;/b&gt; outbox dispatcher &amp;nbsp;&amp;middot;&amp;nbsp; consumer: &lt;b&gt;analysis-worker&lt;/b&gt; (hardcoded 1 per receive)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=9;fontStyle=0;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="1626" y="1328" width="790" height="112" as="geometry" />
        </mxCell>
        <mxCell id="p1-sqsn" value="Startup refuses a URL that is not &lt;code&gt;https&lt;/code&gt; and does not end in &lt;code&gt;.fifo&lt;/code&gt; &amp;mdash; per-station ordering is a correctness requirement. FIFO deduplication lasts only 5 minutes, so it is &lt;b&gt;defence in depth&lt;/b&gt;; the &lt;code&gt;inbox_messages&lt;/code&gt; table is the actual guarantee. No dead-letter code exists: redrive is a queue attribute owned by infrastructure, and a message whose failure is already understood is recorded in &lt;code&gt;processing_failures&lt;/code&gt; and deleted." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#F0B6D2;fontColor=#232F3E;fontSize=9;fontStyle=0;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="460" y="1458" width="1970" height="48" as="geometry" />
        </mxCell>
        <mxCell id="p1-sql" value="SQLite (WAL) on EBS &amp;mdash; the system of record. Every connection gets four pragmas: journal_mode=WAL, foreign_keys=ON, busy_timeout=30000, synchronous=NORMAL. Migrations are forward-only (0003&amp;ndash;0007)." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FBF3FC;strokeColor=#C925D1;fontColor=#C925D1;fontSize=13;fontStyle=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="430" y="1550" width="2030" height="190" as="geometry" />
        </mxCell>
        <mxCell id="p1-tb0" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E5C7EA;fontColor=#232F3E;fontSize=11;fontStyle=0;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="452" y="1602" width="310" height="118" as="geometry" />
        </mxCell>
