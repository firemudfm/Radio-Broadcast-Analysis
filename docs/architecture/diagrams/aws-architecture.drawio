        <mxCell id="p1-d1b" value="D1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#3334B9;strokeColor=#ffffff;strokeWidth=2;fontColor=#ffffff;fontSize=10;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="486" y="246" width="28" height="28" as="geometry" />
        </mxCell>
        <mxCell id="p1-d2" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#DD344C;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.role;" vertex="1" parent="1">
          <mxGeometry x="830" y="261" width="78" height="44" as="geometry" />
        </mxCell>
        <mxCell id="p1-d2lbl" value="&lt;b&gt;GitHubActionsRadioDeployRole&lt;/b&gt;&lt;br&gt;sts:AssumeRoleWithWebIdentity&lt;br&gt;sub pinned to &lt;code&gt;&amp;hellip;:environment:production&lt;/code&gt;&lt;br&gt;DENY StartSession / RunShellScript / iam:*" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5DBE3;fontColor=#232F3E;fontSize=9;fontStyle=0;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="750" y="328" width="238" height="74" as="geometry" />
        </mxCell>
        <mxCell id="p1-d2b" value="D2" style="ellipse;whiteSpace=wrap;html=1;fillColor=#3334B9;strokeColor=#ffffff;strokeWidth=2;fontColor=#ffffff;fontSize=10;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
