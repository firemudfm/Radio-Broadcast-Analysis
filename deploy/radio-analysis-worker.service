[Unit]
Description=FireMud shared full-transcript conversation analysis worker
After=network-online.target radio-llm.service radio-intelligence-api.service
Wants=network-online.target radio-llm.service

[Service]
Type=simple
User=radio
Group=radio
WorkingDirectory=/opt/firemud/radio-intelligence-api
EnvironmentFile=/etc/firemud/radio-intelligence.env
ExecStart=/opt/firemud/radio-intelligence-api/venv/bin/python -m app.analysis_worker
Restart=always
RestartSec=10
TimeoutStopSec=30
Nice=8
CPUQuota=150%
MemoryMax=768M

NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/var/lib/firemud/radio-intelligence-api

[Install]
WantedBy=multi-user.target
