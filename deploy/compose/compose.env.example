# Compose CLI environment -- interpolation and deployment behaviour.
#
# This is NOT the container environment. Application settings and secrets live
# in the two files the containers read:
#
#   /etc/radio-broadcast-analysis/infrastructure.env
#   /etc/radio-broadcast-analysis/application.env
#
# This file controls how Compose renders the stack and how the deployment
# scripts behave. It contains no secrets and is safe to read.
#
# Production copy: /etc/radio-broadcast-analysis/compose.env  (never committed)
#
#   sudo install -m 0640 -o root -g root \
#     deploy/compose/compose.env.example \
#     /etc/radio-broadcast-analysis/compose.env

# -----------------------------------------------------------------------------
# Project identity
# -----------------------------------------------------------------------------
# Fixed so `--remove-orphans` only ever affects this stack. A project name that
# changes between deploys orphans the previous containers instead of replacing
# them.
COMPOSE_PROJECT_NAME=radio-prod

# -----------------------------------------------------------------------------
# API exposure
# -----------------------------------------------------------------------------
# 127.0.0.1 is the safe default and what the deployment script expects.
#
# 0.0.0.0 publishes an UNAUTHENTICATED, UNENCRYPTED API to every interface.
# The deployment script refuses it unless RADIO_ALLOW_DIRECT_HTTP=1 is also
# set, and even then it is a restricted-pilot option, not a recommended
# architecture. Restricting access is then the host firewall's job.
RADIO_API_PUBLISH_HOST=127.0.0.1
RADIO_ALLOW_DIRECT_HTTP=0

# -----------------------------------------------------------------------------
# Container runtime identity
# -----------------------------------------------------------------------------
# Left EMPTY on purpose, so the deployment auto-detects the host account.
#
# These must match whatever account owns /var/lib/radio, or bind-mounted
# directories will not be writable. Pinning a number in a public template is
# how that goes wrong: this file previously shipped 10001 while documenting
# that the host is 992, so a copied default would have built images that could
# not write to their own data directories.
#
# Left unset, scripts/deploy-compose.sh reads `id -u radio` and `id -g radio`
# from the host and uses those. Building Compose directly, without the
# deployment script, falls back to 10001:10001 -- the generic development
# default baked into the Dockerfiles.
#
# Set them only to deliberately override the host account; the deployment warns
# when a pinned value disagrees with the real one. Ownership problems are
# always reported, never repaired: the deployment performs no recursive chown,
# because silently rewriting ownership across a data volume can take a very
# long time and can break another service that shares a path.
#
# Check the host with: id -u radio && id -g radio
RADIO_CONTAINER_UID=
RADIO_CONTAINER_GID=

# -----------------------------------------------------------------------------
# Deployment layout
# -----------------------------------------------------------------------------
RADIO_RELEASE_ROOT=/var/lib/radio/releases
RADIO_DEPLOY_ROOT=/var/lib/radio/deploy

# There is deliberately no RADIO_DEPLOY_PROFILES here. It used to be documented
# as a "ceiling" on which profiles a deployment may start, but nothing read it,
# so it silently constrained nothing. --stage is the single source of truth for
# which services start, and a settable variable that has no effect is worse than
# no variable at all: it reads as a safety control while providing none.

# -----------------------------------------------------------------------------
# Host data paths (bind mount sources)
# -----------------------------------------------------------------------------
RADIO_HOST_DATABASE=/var/lib/radio/database
RADIO_HOST_SPOOL=/var/lib/radio/spool
RADIO_HOST_MODELS=/var/lib/radio/models
RADIO_HOST_EVIDENCE=/var/lib/radio/evidence
RADIO_HOST_LOGS=/var/lib/radio/logs
RADIO_HOST_BACKUPS=/var/lib/radio/backups

# -----------------------------------------------------------------------------
# Image tags
# -----------------------------------------------------------------------------
# Left unset on purpose. scripts/deploy-compose.sh sets these to the exact
# commit SHA being deployed; a value here would let a stale tag win.
# RADIO_API_IMAGE=
# RADIO_PIPELINE_IMAGE=
# RADIO_LLM_IMAGE=

LLAMA_CPP_TAG=b10144
