# Development application values. Safe to commit: the token secret below is a
# fixed placeholder that grants nothing outside a local container.
RADIO_AUDIO_TOKEN_SECRET=development-only-secret-not-for-production-use
# In-process queues: the dev loop runs end to end with no AWS account at all.
RADIO_QUEUE_BACKEND=memory
RADIO_SEGMENT_STORE=local
RADIO_ASR_BACKEND=fake
RADIO_LLM_ENABLED=false
RADIO_MAX_ACTIVE_UNIQUE_STATIONS=2
RADIO_LISTENER_MAX_SESSIONS=2
LOG_LEVEL=DEBUG
RADIO_LOG_FORMAT=text
