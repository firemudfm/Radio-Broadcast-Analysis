APP_ENV="development"
LOG_LEVEL="INFO"

AWS_REGION="eu-north-1"
AWS_DEFAULT_REGION="eu-north-1"
RADIO_S3_BUCKET="REPLACE_WITH_PIPELINE_BUCKET"
RADIO_RESULTS_PREFIX="results/intelligence/"
RADIO_ANALYSIS_PREFIX="results/conversation-analysis/"
RADIO_KEYWORDS_KEY="config/keywords/keywords.json"
RADIO_RAW_PREFIX="raw-audio/"
RADIO_TRANSCRIPTS_PREFIX="transcripts/"

RADIO_API_HOST="127.0.0.1"
RADIO_API_PORT="8788"
RADIO_API_CORS_ORIGINS="http://localhost:5175,http://127.0.0.1:5175"

RADIO_DATABASE_PATH="/var/lib/firemud/radio-intelligence-api/radio.db"
RADIO_AUDIO_TOKEN_SECRET="REPLACED_BY_INSTALLER"
RADIO_AUDIO_TOKEN_TTL_SECONDS="600"

RADIO_SYNC_ENABLED="true"
RADIO_SYNC_ON_STARTUP="true"
RADIO_SYNC_INTERVAL_SECONDS="15"
RADIO_SYNC_LOOKBACK_DAYS="14"
RADIO_SYNC_MAX_OBJECTS="1000"

RADIO_STATION_CONFIG_DIR="/etc/radio-pipeline/stations"
RADIO_STATION_METADATA_PATH="/etc/firemud/radio-stations.json"
RADIO_STATION_REFRESH_SECONDS="60"

# Complete contiguous speech session around the mention. Session boundaries
# come from real speech gaps, not a fixed before/after window.
RADIO_CONVERSATION_MAX_TRANSCRIPTS="200"
RADIO_CONVERSATION_SCAN_CHUNKS="6"
RADIO_CONVERSATION_SESSION_GAP_SECONDS="30"
RADIO_CONVERSATION_MAX_DURATION_SECONDS="1800"
RADIO_CONVERSATION_MAX_CHARACTERS="120000"

# Local Qwen3 0.6B service, reachable only from this EC2 instance.
RADIO_LLM_ENABLED="true"
RADIO_LLM_BASE_URL="http://127.0.0.1:8790"
RADIO_LLM_MODEL="qwen3-0.6b-q8"
RADIO_LLM_TIMEOUT_SECONDS="90"
RADIO_LLM_MAX_INPUT_CHARACTERS="40000"
RADIO_LLM_MAX_OUTPUT_TOKENS="480"
RADIO_LLM_TEMPERATURE="0.1"

# One shared bounded analysis worker for every campaign. It does not create one
# model process per campaign.
RADIO_ANALYSIS_WORKER_ENABLED="true"
RADIO_ANALYSIS_WORKER_POLL_SECONDS="20"
RADIO_ANALYSIS_WORKER_BATCH_SIZE="2"
RADIO_ANALYSIS_RETRY_LIMIT="3"
# Wait for following radio chunks before the first LLM summary so an ongoing
# conversation can be assembled; the detail endpoint itself stays responsive.
RADIO_ANALYSIS_SETTLE_SECONDS="360"

# Opt-in cross-language concept/topic matching. Brand/person/product keywords
# remain exact/alias-first unless semantic_matching=true is sent by the client.
RADIO_SEMANTIC_DISCOVERY_ENABLED="true"
RADIO_SEMANTIC_SCAN_LOOKBACK_DAYS="7"
RADIO_SEMANTIC_GROUPS_PER_CYCLE="1"
RADIO_SEMANTIC_KEYWORDS_PER_GROUP="10"
RADIO_SEMANTIC_DEFAULT_THRESHOLD="0.74"
RADIO_SEMANTIC_SETTLE_SECONDS="120"
RADIO_SEMANTIC_RESULTS_PREFIX="results/semantic-matches/"

# --- v0.4 radio catalogue, monitoring, and admission control -----------------
RADIO_BROWSER_USER_AGENT="FireMudRadioMonitor/0.4 (+EC2 pilot)"
RADIO_BROWSER_MIRROR_REFRESH_SECONDS="1800"
RADIO_BROWSER_COUNTRY_CACHE_SECONDS="21600"
RADIO_BROWSER_SEARCH_CACHE_SECONDS="600"
RADIO_BROWSER_STATION_CACHE_SECONDS="300"
RADIO_BROWSER_REQUEST_TIMEOUT_SECONDS="10"
RADIO_BROWSER_MAX_ATTEMPTS="3"
# Optional refresh source for the curated override snapshot (backend only;
# the browser never downloads this):
RADIO_DATABASE_OVERRIDE_URL="https://db.radio-browser.info/all.json"
RADIO_DATABASE_OVERRIDE_REFRESH_SECONDS="21600"
# Hard admission limits for this 8-vCPU CPU-only instance:
RADIO_MAX_ACTIVE_STATIONS="2"
RADIO_MAX_STATIONS_PER_CAMPAIGN="10"
RADIO_ALLOW_COUNTRY_ALL="false"
RADIO_STATION_STOP_GRACE_SECONDS="300"
RADIO_PREVIEW_TOKEN_TTL_SECONDS="120"
RADIO_PREVIEW_MAX_SECONDS="60"
RADIO_PREVIEW_MAX_CONCURRENT="2"
RADIO_PROBE_SECONDS="20"
RADIO_RECONCILER_POLL_SECONDS="10"
# Stations that must never be stopped by the reconciler:
RADIO_LEGACY_PINNED_STATION_IDS="hertz879"
