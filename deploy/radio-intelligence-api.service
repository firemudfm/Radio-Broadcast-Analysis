[Unit]
Description=FireMud Radio Intelligence FastAPI open pilot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=radio
Group=radio
WorkingDirectory=/opt/firemud/radio-intelligence-api
EnvironmentFile=/etc/firemud/radio-intelligence.env
ExecStart=/opt/firemud/radio-intelligence-api/venv/bin/python -m app
Restart=always
RestartSec=5
TimeoutStopSec=30

NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/var/lib/firemud/radio-intelligence-api

[Install]
WantedBy=multi-user.target
