# Production application settings -- PUBLIC TEMPLATE, no secrets.
#
# Installed to /etc/radio-broadcast-analysis/application.env on first install
# and never overwritten afterwards. Every name below was checked against the
# Settings model in app/config.py; a setting that does not exist there would be
# silently ignored, which is worse than being absent.
#
# The one secret is a marker, replaced once at install time with 48 random
# bytes from a cryptographically secure source. It is never regenerated, because
# rotating it invalidates every audio token already issued.

# -----------------------------------------------------------------------------
# Secrets
# -----------------------------------------------------------------------------
# The placeholder below is substituted by scripts/ensure-production-config.sh,
# which requires it to appear EXACTLY ONCE in this file. Do not name it anywhere
# else here, not even in a comment: every occurrence is replaced, so a comment
# that mentioned it would be handed the generated secret and application.env
# would leak it in plain sight. That rule is enforced, and a first install stops
# rather than write a secret somewhere nobody would think to look.
#
# If the placeholder is still here on a running host, the configuration was
# never initialised and the API will refuse to start.
RADIO_AUDIO_TOKEN_SECRET=REPLACE_WITH_GENERATED_SECRET

# -----------------------------------------------------------------------------
# Pipeline
# -----------------------------------------------------------------------------
# The shared-station SQS pipeline: one connection per DISTINCT station, one
# combined keyword index per station, each segment transcribed once.
RADIO_QUEUE_BACKEND=sqs
RADIO_SEGMENT_STORE=local

# -----------------------------------------------------------------------------
# Capacity -- deliberately ONE station for the pilot
# -----------------------------------------------------------------------------
# This is a 4 vCPU / 8 GiB aarch64 host running ASR, an LLM and the API. One
# unique live station is the capacity this deployment is verified for.
#
# These are NOT placeholders to raise casually. Raising them without measuring
# real transcription throughput on this instance is how the spool fills and
# audio is lost. There is no evidence this host supports anything near 1,000
# live stations, and nothing here should be read as claiming otherwise.
# How many DISTINCT stations campaigns may request. A control-plane number:
# rows, campaign mappings and keyword indexes. Proven to 1,000 by the load suite.
RADIO_MAX_REQUESTED_UNIQUE_STATIONS=1000

# How many are DECODED at once. A compute number: one ffmpeg decode, one ring
# buffer and a share of ASR each. Stations beyond this are parked as
# pending_capacity, which is a queue rather than a refusal.
RADIO_MAX_ACTIVE_UNIQUE_STATIONS=1
RADIO_LISTENER_MAX_SESSIONS=1

# Single listener process; sharding exists for a future multi-host layout.
RADIO_LISTENER_SHARD_COUNT=1
RADIO_LISTENER_SHARD_INDEX=0

# -----------------------------------------------------------------------------
# Analysis
# -----------------------------------------------------------------------------
# The local Qwen model runs only AFTER a keyword match is confirmed, never
# speculatively on every segment.
RADIO_LLM_ENABLED=true

# Off for the pilot: semantic discovery widens what is analysed beyond confirmed
# keyword matches, and the capacity above does not budget for it.
RADIO_SEMANTIC_DISCOVERY_ENABLED=false

# -----------------------------------------------------------------------------
# Audio retention policy
# -----------------------------------------------------------------------------
# Songs are discarded. Speech over a music bed is NOT a song -- it is how most
# radio advertising and presenter talk actually sounds, and discarding it would
# drop the majority of real brand mentions.
RADIO_INCLUDE_SONG_LYRICS=false
RADIO_INCLUDE_SPEECH_OVER_MUSIC=true

# Uncertain audio is transcribed rather than discarded: the cost of transcribing
# something that turns out to be music is a little CPU, and the cost of
# discarding something that turns out to be a mention is a missed mention.
RADIO_TRANSCRIBE_UNCERTAIN_AUDIO=true
