# Example configuration. Copy to `.env` for local Compose use, or split into
# /etc/radio-broadcast-analysis/{infrastructure,application}.env in production.
#
# NEVER commit a filled-in copy. `.env`, `application.env` and
# `infrastructure.env` are all git-ignored and .dockerignore'd; the values below
# are placeholders that will not work anywhere.

# =============================================================================
# infrastructure.env  -- account-specific, changes per environment
# =============================================================================
#
# This file is a PUBLIC TEMPLATE and carries no real account identifiers.
# The real bucket name, queue URLs and account id belong only in
# /etc/radio-broadcast-analysis/infrastructure.env on the host, which is
# git-ignored and .dockerignore'd.
#
# An account id is not a secret, but publishing one in a public repository is
# free reconnaissance, and a realistic-looking value invites someone to copy it
# into a deployment where it half-works.

# Region is not account-specific and is kept as the recommended example.
AWS_REGION=eu-north-1

# Obviously non-functional on purpose: this must fail loudly rather than
# silently resolve to somebody's bucket.
RADIO_S3_BUCKET=replace-me-radio-bucket

# SQS FIFO queue URLs. Required whenever RADIO_QUEUE_BACKEND=sqs, which is
# every production deployment.
#
# Left empty rather than filled with a dummy account URL: a plausible-looking
# URL would pass start-up validation and point the pipeline at a queue that
# does not exist. Empty makes `shared_sqs` + `sqs` fail immediately with a
# named configuration error, which is the outcome we want.
#
# Both names MUST end in `.fifo`. Per-station ordering is a correctness
# requirement, and a standard queue would silently reorder segments.
RADIO_TRANSCRIPTION_QUEUE_URL=
RADIO_ANALYSIS_QUEUE_URL=

# AWS credentials are NOT set here, and no AWS_ACCESS_KEY_ID /
# AWS_SECRET_ACCESS_KEY / AWS_SESSION_TOKEN variable belongs in this file.
# The EC2 instance role supplies credentials; a static key in an env file is a
# credential with no rotation and no audit trail.

# =============================================================================
# application.env  -- behaviour, mostly stable across environments
# =============================================================================

# -- secrets ------------------------------------------------------------------
# Minimum 32 characters, validated at start-up. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
RADIO_AUDIO_TOKEN_SECRET=replace-me-with-at-least-32-random-characters

# -- pipeline -----------------------------------------------------------------
# There is one pipeline: shared station + SQS. There is no mode to select.
#
# `memory` exists for the deterministic test suite and compose.dev; production
# is required to use `sqs` (APP_ENV=production enforces it), because the memory
# queue loses every message when the process restarts.
RADIO_QUEUE_BACKEND=sqs
RADIO_SEGMENT_STORE=local

# -- paths --------------------------------------------------------------------
RADIO_DATABASE_PATH=/var/lib/radio/database/radio.db
RADIO_SPOOL_PATH=/var/lib/radio/spool
RADIO_MODEL_PATH=/models
RADIO_EVIDENCE_PATH=/var/lib/radio/evidence
RADIO_LOG_PATH=/var/lib/radio/logs

# Host directories bind-mounted into the containers.
RADIO_HOST_DATABASE=/var/lib/radio/database
RADIO_HOST_SPOOL=/var/lib/radio/spool
RADIO_HOST_MODELS=/var/lib/radio/models
RADIO_HOST_EVIDENCE=/var/lib/radio/evidence
RADIO_HOST_LOGS=/var/lib/radio/logs
RADIO_HOST_BACKUPS=/var/lib/radio/backups

# -- capacity -----------------------------------------------------------------
# THREE DIFFERENT NUMBERS. Reading one as another is how "1,000 stations"
# becomes a claim about live decoding that nobody measured.
#
# How many DISTINCT stations campaigns may request. Control plane: rows,
# campaign mappings and keyword indexes. Proven to 1,000 by the load suite.
RADIO_MAX_REQUESTED_UNIQUE_STATIONS=1000

# How many are DECODED at once. Compute: one ffmpeg decode, one ring buffer and
# a share of ASR each. Stations beyond this are parked as pending_capacity,
# which is a queue rather than a refusal. NOT benchmarked above 1 on this host;
# raise it only with measurements (docs/CAPACITY.md).
RADIO_MAX_ACTIVE_UNIQUE_STATIONS=1
RADIO_LISTENER_MAX_SESSIONS=1

# Sharding is wired but unused at one node. Adding a second listener means
# raising the count and giving each container a distinct index.
RADIO_LISTENER_SHARD_COUNT=1
RADIO_LISTENER_SHARD_INDEX=0

# -- audio --------------------------------------------------------------------
RADIO_SAMPLE_RATE=16000
RADIO_RING_BUFFER_SECONDS=60
RADIO_PRE_KEYWORD_SECONDS=30
RADIO_SPEECH_CHUNK_SECONDS=20
RADIO_CHUNK_OVERLAP_SECONDS=1.0
RADIO_SILENCE_END_SECONDS=12
RADIO_PURE_MUSIC_DISCARD_SECONDS=8
RADIO_MAX_CONVERSATION_SECONDS=300

# vad_energy   : energy/ZCR signals plus Silero VAD when the model is present
# passthrough  : transcribe everything (maximum recall, maximum cost)
# yamnet       : reserved; refuses to start (see ADR-005)
RADIO_AUDIO_CLASSIFIER=vad_energy
RADIO_TRANSCRIBE_UNCERTAIN_AUDIO=true

# -- ASR ----------------------------------------------------------------------
RADIO_ASR_BACKEND=faster_whisper
RADIO_ASR_MODEL=Systran/faster-whisper-small
RADIO_ASR_CONFIRMATION_MODEL=Systran/faster-whisper-small
RADIO_ASR_DEVICE=cpu
RADIO_ASR_COMPUTE_TYPE=int8
RADIO_ASR_CPU_THREADS=2
RADIO_ASR_BEAM_SIZE=1
RADIO_ASR_CONFIRMATION_BEAM_SIZE=5

# -- content policy defaults --------------------------------------------------
RADIO_INCLUDE_SONG_LYRICS=false
RADIO_INCLUDE_LONG_FORM_SINGING=false
RADIO_INCLUDE_SUNG_ADVERTISING_JINGLES=true
RADIO_INCLUDE_SPEECH_OVER_MUSIC=true

# -- LLM ----------------------------------------------------------------------
RADIO_LLM_ENABLED=true
# Compose service name. Port 8790 is never published to the host.
RADIO_LLM_BASE_URL=http://llm:8790
RADIO_LLM_MODEL_PATH=/models/qwen/Qwen3-0.6B-Q8_0.gguf
RADIO_LLM_TIMEOUT_SECONDS=90
RADIO_LLM_MAX_OUTPUT_TOKENS=768
RADIO_LLM_THREADS=2
RADIO_LLM_CONTEXT=4096

# -- hosted analysis LLM chain (optional tiers above the local model) ---------
# Failover order is fixed: NVIDIA, then Ollama, then Groq, then Mistral,
# then Gemini, then the local
# llama server above. Any tier error moves the SAME analysis to the next tier
# and rests the failed tier for RADIO_LLM_REMOTE_RETRY_SECONDS (default 2
# hours); expired tiers are climbed back to automatically. Cooldowns are per
# tier, so one dead provider never hides a healthy one. Enabling a tier
# without its key refuses to start. REAL keys belong only in the host's
# git-ignored application.env, never in this template.
RADIO_LLM_REMOTE_RETRY_SECONDS=7200

# Tier 1: NVIDIA (key from RADIO_LLM_REMOTE_API_KEY or NVIDIA_API_KEY)
RADIO_LLM_REMOTE_ENABLED=true
NVIDIA_API_KEY=nvapi-your-key-here
RADIO_LLM_REMOTE_BASE_URL=https://integrate.api.nvidia.com/v1
RADIO_LLM_REMOTE_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
RADIO_LLM_REMOTE_TIMEOUT_SECONDS=60
# Provider-specific request knobs, merged into the request body. The main use
# is taming reasoning models that spend the whole output budget thinking
# (log signature: "returned unusable content"). A field the provider rejects
# just cascades the tier with a named HTTP error, so experimenting is safe.
# The default already disables nemotron's prose thinking (verified live).
# Override here only for a different provider; empty sends nothing extra.
RADIO_LLM_REMOTE_EXTRA_BODY={"chat_template_kwargs":{"enable_thinking":false}}

# Tier 2: Ollama cloud (key from RADIO_LLM_OLLAMA_API_KEY or OLLAMA_API_KEY).
# gemma4:31b verified live: ~1.2s per analysis, correct German comprehension,
# non-thinking by design.
RADIO_LLM_OLLAMA_ENABLED=true
OLLAMA_API_KEY=
RADIO_LLM_OLLAMA_BASE_URL=https://ollama.com/v1
RADIO_LLM_OLLAMA_MODEL=gemma4:31b
RADIO_LLM_OLLAMA_TIMEOUT_SECONDS=60

# Tier 3: Groq (key from RADIO_LLM_GROQ_API_KEY or GROQ_API_KEY)
RADIO_LLM_GROQ_ENABLED=true
GROQ_API_KEY=
RADIO_LLM_GROQ_BASE_URL=https://api.groq.com/openai/v1
RADIO_LLM_GROQ_MODEL=qwen/qwen3.6-27b
RADIO_LLM_GROQ_TIMEOUT_SECONDS=60

# Tier 3: Mistral (key from RADIO_LLM_MISTRAL_API_KEY or MISTRAL_API_KEY)
RADIO_LLM_MISTRAL_ENABLED=true
MISTRAL_API_KEY=
RADIO_LLM_MISTRAL_BASE_URL=https://api.mistral.ai/v1
RADIO_LLM_MISTRAL_MODEL=ministral-8b-latest
RADIO_LLM_MISTRAL_TIMEOUT_SECONDS=60

# Tier 4: Gemini, via its OpenAI-compatible endpoint (key from
# RADIO_LLM_GEMINI_API_KEY, GEMINI_API_KEY or GOOGLE_API_KEY). Positioned
# last on purpose: the free tier has a daily request cap, and a fallback
# tier only sees traffic while the tiers above are down.
RADIO_LLM_GEMINI_ENABLED=true
GEMINI_API_KEY=
RADIO_LLM_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
RADIO_LLM_GEMINI_MODEL=gemini-flash-latest
RADIO_LLM_GEMINI_TIMEOUT_SECONDS=60

# -- spool watermarks ---------------------------------------------------------
# Must satisfy warning < pause < emergency <= 99, enforced at start-up.
RADIO_SPOOL_WARNING_PERCENT=70
RADIO_SPOOL_PAUSE_PERCENT=85
RADIO_SPOOL_EMERGENCY_PERCENT=90
RADIO_NO_HIT_RETENTION_MINUTES=10
RADIO_FAILED_SEGMENT_RETENTION_HOURS=24
RADIO_EVIDENCE_RETENTION_DAYS=14

# -- observability ------------------------------------------------------------
LOG_LEVEL=INFO
RADIO_LOG_FORMAT=json
# Transcript bodies are broadcast content, not operational data. Enabling this
# puts the product's output into log aggregation; leave it off.
RADIO_LOG_TRANSCRIPT_BODIES=false

# -- images (optional) --------------------------------------------------------
RADIO_API_IMAGE=radio-api:local
RADIO_PIPELINE_IMAGE=radio-pipeline:local
RADIO_LLM_IMAGE=radio-llm:local
LLAMA_CPP_TAG=b10144
